import DaggerModelsPartII.JTEndpointCobase
import Mathlib.AlgebraicTopology.SimplicialSet.SubcomplexColimits

/-!
# The fixed base and actual legs cover an undercategory colimit

The underlying simplicial set of a colimit in Under B is generated by
the fixed base and its actual cocone legs. The index may be empty or
disconnected; the forgetful functor need not preserve its colimit.
-/

set_option autoImplicit false

open CategoryTheory Limits Opposite

namespace DaggerModels.PartII.UnderColimitCoverage

noncomputable section

variable {I : Type} [Category.{0} I] {B : SSet.{0}} (F : I ⥤ Under B)

private def generated : (colimit F).right.Subcomplex :=
  SSet.Subcomplex.range (colimit F).hom ⊔
    ⨆ i : I, SSet.Subcomplex.range (colimit.ι F i).right

private def base : B ⟶ (generated F).toSSet :=
  SSet.Subcomplex.lift (colimit F).hom le_sup_left

private def leg (i : I) : (F.obj i).right ⟶ (generated F).toSSet :=
  SSet.Subcomplex.lift (colimit.ι F i).right
    (le_sup_of_le_right (le_iSup (fun j ↦
      SSet.Subcomplex.range (colimit.ι F j).right) i))

private theorem base_ι : base F ≫ (generated F).ι = (colimit F).hom := rfl

private theorem leg_ι (i : I) :
    leg F i ≫ (generated F).ι = (colimit.ι F i).right := rfl

private def generatedUnder : Under B := Under.mk (base F)

private def underLeg (i : I) : F.obj i ⟶ generatedUnder F :=
  Under.homMk (leg F i) (by
    change (F.obj i).hom ≫ leg F i = base F
    apply (cancel_mono (generated F).ι).1
    rw [Category.assoc, leg_ι, base_ι]
    exact Under.w (colimit.ι F i))

private def generatedCocone : Cocone F where
  pt := generatedUnder F
  ι :=
    { app := underLeg F
      naturality := by
        intro i j f
        apply Under.UnderMorphism.ext
        apply (cancel_mono (generated F).ι).1
        change ((F.map f).right ≫ leg F j) ≫ (generated F).ι =
          (leg F i ≫ 𝟙 _) ≫ (generated F).ι
        rw [Category.comp_id, Category.assoc, leg_ι, leg_ι]
        exact congrArg (fun g ↦ g.right) (colimit.w F f) }

private def inclusion : generatedUnder F ⟶ colimit F :=
  Under.homMk (generated F).ι (base_ι F)

private theorem desc_inclusion :
    colimit.desc F (generatedCocone F) ≫ inclusion F = 𝟙 (colimit F) := by
  apply colimit.hom_ext
  intro i
  rw [← Category.assoc, colimit.ι_desc, Category.comp_id]
  apply Under.UnderMorphism.ext
  exact leg_ι F i

/-- The fixed base and all actual diagram legs generate the entire
underlying simplicial set of the actual undercategory colimit. -/
theorem generated_eq_top :
    SSet.Subcomplex.range (colimit F).hom ⊔
      (⨆ i : I, SSet.Subcomplex.range (colimit.ι F i).right) = ⊤ := by
  change generated F = ⊤
  apply le_antisymm le_top
  intro q x _
  let y := (colimit.desc F (generatedCocone F)).right.app q x
  have hy : y.val = x := by
    have h := congrArg (fun g : colimit F ⟶ colimit F ↦ g.right)
      (desc_inclusion F)
    exact congrFun (NatTrans.congr_app h q) x
  have hmem := y.property
  rwa [hy] at hmem

/-- Every underlying simplex of an undercategory colimit comes from
the specified fixed base or from an actual diagram value. -/
theorem jointly_surjective (q : SimplexCategoryᵒᵖ)
    (x : (colimit F).right.obj q) :
    (∃ b : B.obj q, (colimit F).hom.app q b = x) ∨
      ∃ (i : I) (y : (F.obj i).right.obj q), (colimit.ι F i).right.app q y = x := by
  have hx : x ∈ (SSet.Subcomplex.range (colimit F).hom ⊔
      (⨆ i : I, SSet.Subcomplex.range (colimit.ι F i).right)).obj q := by
    rw [generated_eq_top]
    trivial
  change x ∈ (SSet.Subcomplex.range (colimit F).hom).obj q ∪
    (⨆ i : I, SSet.Subcomplex.range (colimit.ι F i).right).obj q at hx
  simpa only [Subfunctor.iSup_obj, Subfunctor.range_obj,
    Set.mem_union, Set.mem_iUnion, Set.mem_range] using hx

end

end DaggerModels.PartII.UnderColimitCoverage
