import OrdinaryWalkingAlternatingExhaustion
import Mathlib.AlgebraicTopology.SimplicialSet.Horn

/-!
# Nonzero faces in the alternating walking-groupoid filtration

Deleting a nonzero vertex from an alternating word produces a word already
generated by the preceding alternating simplex. Consequently the outer horn
at zero maps into the preceding literal stage. The reverse preimage
inclusion and uniqueness away from the horn are separate combinatorial
requirements for the attachment pushout; they are not asserted here.
-/

set_option autoImplicit false
set_option warningAsError true

open CategoryTheory Opposite Simplicial

namespace DaggerModels.PartII.OrdinaryWalkingAlternatingAttachment

open OrdinaryWalkingAlternatingFiltration

noncomputable section

private abbrev Walking := GroupoidSimplex.parameter.obj ⦋1⦌
private abbrev BinaryNerve :=
  DaggerOriginalCodiscreteNerveInjective.codiscreteNerve.obj (Fin 2)

/-- After deleting a nonzero vertex, repeat the preceding position at the
deleted vertex and shift all later positions back by one. -/
private def faceCode (k : ℕ) (i : Fin (k + 3)) (hi : 0 < i) :
    ⦋k + 1⦌ ⟶ ⦋k + 1⦌ :=
  SimplexCategory.mkHom
    ⟨fun j ↦ ⟨if j.val < i.val then j.val else j.val - 1, by
        have hj := j.isLt
        split_ifs <;> omega⟩,
      by
        intro a b hab
        apply Fin.le_iff_val_le_val.mpr
        have hab' := Fin.le_iff_val_le_val.mp hab
        dsimp
        split_ifs <;> omega⟩

private theorem faceCode_parity (k : ℕ) (i : Fin (k + 3)) (hi : 0 < i)
    (j : Fin (k + 2)) :
    (i.succAbove j).val % 2 = ((faceCode k i hi).toOrderHom j).val % 2 := by
  have hj := j.isLt
  have hi' := i.isLt
  change (if j.castSucc < i then j.castSucc else j.succ).val % 2 =
    (if j.val < i.val then j.val else j.val - 1) % 2
  by_cases h : j.val < i.val
  · have h' : j.castSucc < i := Fin.lt_def.mpr h
    simp only [h, h', ↓reduceIte, Fin.val_castSucc]
  · have h' : ¬ j.castSucc < i := by
      exact fun h' ↦ h (Fin.lt_def.mp h')
    simp only [h, h', ↓reduceIte, Fin.val_succ]
    have hj' : 1 ≤ j.val := by omega
    omega

/-- A nonzero face of the next binary word is a degeneracy of a simplex in
the preceding stage. This is the exact word equation used for the horn. -/
theorem binaryWord_nonzeroFace (k : ℕ) (i : Fin (k + 3)) (hi : 0 < i) :
    BinaryNerve.map (SimplexCategory.δ i).op (binaryWord (k + 2)) =
      BinaryNerve.map (faceCode k i hi).op (binaryWord (k + 1)) := by
  apply nerve.ext_of_isThin
  funext j
  apply Codiscrete.ext
  change (⟨(i.succAbove j).val % 2, Nat.mod_lt _ (by decide)⟩ : Fin 2) =
    ⟨((faceCode k i hi).toOrderHom j).val % 2, Nat.mod_lt _ (by decide)⟩
  apply Fin.ext
  exact faceCode_parity k i hi j

/-- Every nonzero face of the actual alternating simplex is contained in
the preceding literal subcomplex. -/
theorem alternatingSimplex_nonzeroFace_mem (k : ℕ)
    (i : Fin (k + 3)) (hi : 0 < i) :
    Walking.map (SimplexCategory.δ i).op (alternatingSimplex (k + 2)) ∈
      (stage (k + 1)).obj (op ⦋k + 1⦌) := by
  rw [stage, SSet.Subcomplex.mem_ofSimplex_obj_iff]
  refine ⟨faceCode k i hi, ?_⟩
  have h₁ := congrFun (walkingCodiscreteIso.inv.naturality
    (SimplexCategory.δ i).op) (binaryWord (k + 2))
  have h₂ := congrFun (walkingCodiscreteIso.inv.naturality
    (faceCode k i hi).op) (binaryWord (k + 1))
  change Walking.map (SimplexCategory.δ i).op (alternatingSimplex (k + 2)) =
    walkingCodiscreteIso.inv.app (op ⦋k + 1⦌)
      (BinaryNerve.map (SimplexCategory.δ i).op (binaryWord (k + 2))) at h₁
  change Walking.map (faceCode k i hi).op (alternatingSimplex (k + 1)) =
    walkingCodiscreteIso.inv.app (op ⦋k + 1⦌)
      (BinaryNerve.map (faceCode k i hi).op (binaryWord (k + 1))) at h₂
  rw [binaryWord_nonzeroFace k i hi] at h₁
  exact h₂.trans h₁.symm

/-- The generating alternating simplex, as a map from the standard simplex
to the original walking parameter. -/
def attachmentMap (k : ℕ) : Δ[k] ⟶ Walking :=
  SSet.yonedaEquiv.symm (alternatingSimplex k)

/-- The zero outer horn of the next simplex lands in the preceding stage.
This is one direction of the exact intersection needed for the pushout. -/
theorem horn_le_preimage (k : ℕ) :
    SSet.horn (k + 2) (0 : Fin (k + 3)) ≤
      (stage (k + 1)).preimage (attachmentMap (k + 2)) := by
  rw [SSet.horn_eq_iSup]
  apply iSup_le
  rintro ⟨i, hi⟩
  have hi0 : 0 < i := by
    have hne : i ≠ 0 := by simpa using hi
    exact Fin.pos_iff_ne_zero.mpr hne
  rw [← SSet.stdSimplex.range_δ i]
  rw [← SSet.Subcomplex.image_le_iff]
  rw [← SSet.Subcomplex.range_comp]
  rw [SSet.Subcomplex.range_eq_ofSimplex]
  rw [SSet.yonedaEquiv_comp, SSet.Subcomplex.ofSimplex_le_iff]
  change Walking.map (SimplexCategory.δ i).op
      (alternatingSimplex (k + 2)) ∈
    (stage (k + 1)).obj (op ⦋k + 1⦌)
  exact alternatingSimplex_nonzeroFace_mem k i hi0

#print axioms binaryWord_nonzeroFace
#print axioms alternatingSimplex_nonzeroFace_mem
#print axioms horn_le_preimage

end

end DaggerModels.PartII.OrdinaryWalkingAlternatingAttachment
