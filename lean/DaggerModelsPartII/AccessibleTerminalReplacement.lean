import DaggerModelsPartII.ModelWeakAccessibility
import DaggerModelsPartII.ArrowAccessibility
import CoproductCellSerialization

/-!
# Accessible replacement from a small family

The accessible small-object factorization provides a functorial replacement
whose terminal map lifts against the chosen family. This construction does
not require a model structure localized at that family.
-/

set_option autoImplicit false

open CategoryTheory Limits MorphismProperty HomotopicalAlgebra

universe w v u

namespace DaggerModels.PartII.SmallObjectReplacement

noncomputable section

variable {C : Type u} [Category.{v} C]

/-- Send an object to its terminal arrow. -/
def terminalArrow [HasTerminal C] : C ⥤ Arrow C where
  obj X := Arrow.mk (terminal.from X)
  map f := Arrow.homMk f (𝟙 _) (terminalIsTerminal.hom_ext _ _)
  map_id _ := by apply Arrow.hom_ext <;> rfl
  map_comp _ _ := by
    apply Arrow.hom_ext
    · rfl
    · exact (Category.id_comp _).symm

/-- Terminal arrows preserve filtered colimits. -/
theorem terminalArrow_cardinalAccessible [HasTerminal C] [HasColimitsOfSize.{w, w} C]
    (κ : Cardinal.{w}) [Fact κ.IsRegular] :
    (terminalArrow (C := C)).IsCardinalAccessible κ := by
  constructor
  intro J _ _
  letI := isFiltered_of_isCardinalFiltered J κ
  letI := IsFiltered.isConnected J
  constructor
  intro F
  constructor
  intro c hc
  refine ⟨isColimitArrowOfComponents _ ?_ ?_⟩
  · exact hc
  · exact isColimitConstCocone J (⊤_ C)

variable [ModelCategory C] [IsLocallyPresentable.{w} C] [LocallySmall.{w} C]
  [HasColimitsOfSize.{w, w} C]
  (K : MorphismProperty C) [IsSmall.{w} K]

/-- Functorial replacement built from the specified accessible factorization. -/
def replacement : C ⥤ C :=
  terminalArrow ⋙ (ModelWeakAccessibility.accessibleFactorization K).Z

/-- The natural unit of the small-object replacement. -/
def unit : 𝟭 C ⟶ replacement K :=
  Functor.whiskerLeft terminalArrow (ModelWeakAccessibility.accessibleFactorization K).i

/-- The replacement is right orthogonal to the chosen family at its terminal map. -/
theorem terminal_mem_rlp (X : C) : K.rlp (terminal.from ((replacement K).obj X)) := by
  have h := (ModelWeakAccessibility.accessibleFactorization K).hp (terminalArrow.obj X)
  convert h using 1
  apply terminal.hom_ext

/-- The unit lies in the left class generated by the chosen family. -/
theorem unit_mem_llp (X : C) : K.rlp.llp ((unit K).app X) :=
  (ModelWeakAccessibility.accessibleFactorization K).hi (terminalArrow.obj X)

/-- This particular replacement functor is accessible. -/
theorem replacement_accessible : Functor.IsAccessible.{w} (replacement K) := by
  obtain ⟨κ, hκ, hZ⟩ :=
    (ModelWeakAccessibility.accessibleFactorization_Z_accessible K).exists_cardinal
  letI := hκ
  letI := hZ
  letI := terminalArrow_cardinalAccessible (C := C) κ
  change Functor.IsAccessible.{w}
    (terminalArrow ⋙ (ModelWeakAccessibility.accessibleFactorization K).Z)
  exact Functor.isAccessible_of_isCardinalAccessible _ κ

/-- The unit belongs to every retract-, pushout-, and transfinite-closed
class containing the chosen family. -/
theorem unit_mem_of_stable (P : MorphismProperty C)
    [P.IsStableUnderCobaseChange] [IsStableUnderTransfiniteComposition.{w} P]
    [P.IsStableUnderRetracts] (hK : K ≤ P) (X : C) : P ((unit K).app X) := by
  letI : HasCoproducts.{w} C := by
    intro T
    exact (inferInstance : HasColimitsOfSize.{w, w} C).has_colimits_of_shape (Discrete T)
  letI : HasColimitsOfSize.{0, 0} C := hasColimitsOfSizeShrink.{0, 0} _
  letI : HasSmallObjectArgument.{w} K := DaggerSmithSolutionSet.smallObjectArgument K
  have hcell : (coproducts.{w} K).pushouts ≤ P :=
    (DaggerCoproductCellSerialization.coproduct_pushouts_le K).trans
      ((transfiniteCompositions_monotone ((pushouts_monotone hK).trans P.pushouts_le)).trans
        P.transfiniteCompositions_le)
  have h := unit_mem_llp K X
  rw [K.llp_rlp_of_hasSmallObjectArgument] at h
  exact P.retracts_le _
    (retracts_monotone ((transfiniteCompositions_monotone hcell).trans
      P.transfiniteCompositions_le) _ h)

end

end DaggerModels.PartII.SmallObjectReplacement
