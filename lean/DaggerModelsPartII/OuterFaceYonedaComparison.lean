import DaggerModelsPartII.SegalRepresentables
import DaggerModelsPartII.SpineOuterFacePushout
import DaggerModelsPartII.ReversalDiscreteFreeColimits
import DaggerModelsPartII.C2InvolutionActions

/-!
# The outer-face union and the literal Yoneda subpresheaf

The discrete free dagger outer-face object is identified with the union of
the two outer-face images in the actual reversal Yoneda representable.
-/

set_option autoImplicit false

open CategoryTheory Limits Opposite Simplicial

namespace DaggerModels.PartII.OuterFaceYonedaComparison

open SegalLocalizers SegalRepresentables ReversalOuterFaceLocality
open ReversalOuterFaceSubobject SpineOuterFacePushout

noncomputable section

/-- The range of a map out of a pushout is generated by its two legs. -/
private theorem range_pushout_eq_sup {J : Type*} [Category J]
    {S L R P Y : J ⥤ Type} {i : S ⟶ L} {j : S ⟶ R}
    {a : L ⟶ P} {b : R ⟶ P} (sq : IsPushout i j a b)
    (m : P ⟶ Y) :
    Subfunctor.range (a ≫ m) ⊔ Subfunctor.range (b ≫ m) =
      Subfunctor.range m := by
  ext c y
  change (∃ x, m.app c (a.app c x) = y) ∨
      (∃ x, m.app c (b.app c x) = y) ↔
        ∃ x, m.app c x = y
  constructor
  · rintro (⟨x, rfl⟩ | ⟨x, rfl⟩)
    · exact ⟨a.app c x, rfl⟩
    · exact ⟨b.app c x, rfl⟩
  · rintro ⟨x, rfl⟩
    have sqc : IsPushout (i.app c) (j.app c) (a.app c) (b.app c) := by
      convert IsPushout.map ((evaluation J (Type)).obj c) sq using 1
    rcases Types.eq_or_eq_of_isPushout sqc x with ⟨z, rfl⟩ | ⟨z, rfl⟩
    · exact Or.inl ⟨z, rfl⟩
    · exact Or.inr ⟨z, rfl⟩

/-- Precomposing with an isomorphism does not change the range subfunctor. -/
private theorem range_precomp_iso {J : Type*} [Category J]
    {F G Y : J ⥤ Type} (e : F ≅ G) (m : G ⟶ Y) :
    Subfunctor.range (e.hom ≫ m) = Subfunctor.range m := by
  ext c y
  change (∃ x, m.app c (e.hom.app c x) = y) ↔ ∃ x, m.app c x = y
  constructor
  · rintro ⟨x, rfl⟩
    exact ⟨e.hom.app c x, rfl⟩
  · rintro ⟨x, rfl⟩
    refine ⟨e.inv.app c x, ?_⟩
    have h := congrFun (NatTrans.congr_app e.inv_hom_id c) x
    simpa only [NatTrans.comp_app, Category.id_comp] using congrArg (m.app c) h

/-- The underlying presheaf of an actual free dagger simplex. -/
def simplexPresheaf (l : ℕ) : ReverseSimplexᵒᵖ ⥤ Type :=
  DaggerSSet.toPresheaf.obj (freeSimplex l)

/-- The underlying presheaf of the discrete free dagger outer-face union. -/
def outerFacePresheaf (t : ℕ) : ReverseSimplexᵒᵖ ⥤ Type :=
  DaggerSSet.toPresheaf.obj (freeDagger.obj (ordinaryOuterFaces t : SSet.{0}))

/-- Remove the `ULift` in the representable comparison of free dagger simplices. -/
def simplexPresheafIso (l : ℕ) :
    simplexPresheaf l ≅ yoneda.obj (⟨l⟩ : ReverseSimplex) :=
  ((Functor.whiskeringRight ReverseSimplexᵒᵖ SSet.{0} (Type)
    ).obj ((evaluation SimplexCategoryᵒᵖ (Type)).obj (op ⦋0⦌))).mapIso
      (freeSimplexRepresentable.{0} l) ≪≫
    (uliftYonedaIsoYoneda.{0} (C := ReverseSimplex)).app ⟨l⟩

/-- The target of the dagger outer-face inclusion is the literal discrete Yoneda presheaf. -/
def daggerSimplexYonedaIso (l : ℕ) :
    daggerSimplex.{0} l ≅
      C2InvolutionActions.discreteDiagram.obj
        (yoneda.obj (⟨l⟩ : ReverseSimplex)) :=
  C2InvolutionActions.discreteDiagram.mapIso (simplexPresheafIso l)

/-- The Yoneda map underlying the actual dagger outer-face inclusion. -/
def outerFacePresheafMap (t : ℕ) :
    outerFacePresheaf t ⟶ yoneda.obj (⟨t + 2⟩ : ReverseSimplex) :=
  DaggerSSet.toPresheaf.map (freeDagger.map (ordinaryOuterFaces t).ι) ≫
    (simplexPresheafIso (t + 2)).hom

/-- The outer-face map after discretization is the underlying presheaf map. -/
theorem daggerOuterFaceMap_yoneda (t : ℕ) :
    daggerOuterFaceMap.{0} t ≫ (daggerSimplexYonedaIso (t + 2)).hom =
      C2InvolutionActions.discreteDiagram.map (outerFacePresheafMap t) := rfl

/-- The first face as a map to the outer-face union. -/
def firstFaceLeg (t : ℕ) :
    (Δ[t + 1] : SSet.{0}) ⟶ (ordinaryOuterFaces t : SSet.{0}) :=
  (SSet.stdSimplex.faceSingletonComplIso (0 : Fin (t + 3))).hom ≫
    SSet.Subcomplex.homOfLE
      (le_sup_left : firstOuterFace.{0} t ≤ ordinaryOuterFaces t)

/-- The final face as a map to the outer-face union. -/
def lastFaceLeg (t : ℕ) :
    (Δ[t + 1] : SSet.{0}) ⟶ (ordinaryOuterFaces t : SSet.{0}) :=
  (SSet.stdSimplex.faceSingletonComplIso (Fin.last (t + 2))).hom ≫
    SSet.Subcomplex.homOfLE
      (le_sup_right : lastOuterFace.{0} t ≤ ordinaryOuterFaces t)

@[reassoc (attr := simp)] theorem firstFaceLeg_comp (t : ℕ) :
    firstFaceLeg t ≫ (ordinaryOuterFaces t).ι =
      SSet.stdSimplex.δ (0 : Fin (t + 3)) := by
  simp only [firstFaceLeg, Category.assoc, SSet.Subcomplex.homOfLE_ι,
    SSet.stdSimplex.faceSingletonComplIso_hom_ι]

@[reassoc (attr := simp)] theorem lastFaceLeg_comp (t : ℕ) :
    lastFaceLeg t ≫ (ordinaryOuterFaces t).ι =
      SSet.stdSimplex.δ (Fin.last (t + 2)) := by
  simp only [lastFaceLeg, Category.assoc, SSet.Subcomplex.homOfLE_ι,
    SSet.stdSimplex.faceSingletonComplIso_hom_ι]

/-- The free-simplex/Yoneda comparison commutes with ordinary cofaces. -/
theorem simplexPresheafIso_natural {n m : ℕ}
    (f : ⦋n⦌ ⟶ ⦋m⦌) :
    DaggerSSet.toPresheaf.map (freeDagger.map (SSet.stdSimplex.map f)) ≫
      (simplexPresheafIso m).hom =
    (simplexPresheafIso n).hom ≫
      yoneda.map (ReverseSimplex.inclusion.map f) := by
  apply NatTrans.ext
  funext c x
  have h := congrFun (NatTrans.congr_app
    (NatTrans.congr_app
      ((freeSimplicesRepresentable.{0}).hom.naturality f) c)
      (op ⦋0⦌)) x
  exact congrArg ULift.down h

theorem outerFacePresheafMap_first (t : ℕ) :
    DaggerSSet.toPresheaf.map (freeDagger.map (firstFaceLeg t)) ≫
      outerFacePresheafMap t =
    (simplexPresheafIso (t + 1)).hom ≫
      yoneda.map (firstOuterCoface (t + 1)) := by
  rw [outerFacePresheafMap, ← Category.assoc, ← Functor.map_comp,
    ← Functor.map_comp, firstFaceLeg_comp]
  change DaggerSSet.toPresheaf.map
      (freeDagger.map (SSet.stdSimplex.map (SimplexCategory.δ (0 : Fin (t + 3))))) ≫
      (simplexPresheafIso (t + 2)).hom =
    (simplexPresheafIso (t + 1)).hom ≫
      yoneda.map (ReverseSimplex.inclusion.map
        (SimplexCategory.δ (0 : Fin (t + 3))))
  exact simplexPresheafIso_natural (SimplexCategory.δ (0 : Fin (t + 3)))

theorem outerFacePresheafMap_last (t : ℕ) :
    DaggerSSet.toPresheaf.map (freeDagger.map (lastFaceLeg t)) ≫
      outerFacePresheafMap t =
    (simplexPresheafIso (t + 1)).hom ≫
      yoneda.map (lastOuterCoface (t + 1)) := by
  rw [outerFacePresheafMap, ← Category.assoc, ← Functor.map_comp,
    ← Functor.map_comp, lastFaceLeg_comp]
  rw [lastOuterCoface_eq_delta]
  change DaggerSSet.toPresheaf.map
      (freeDagger.map (SSet.stdSimplex.map
        (SimplexCategory.δ (Fin.last (t + 2))))) ≫
      (simplexPresheafIso (t + 2)).hom =
    (simplexPresheafIso (t + 1)).hom ≫
      yoneda.map (ReverseSimplex.inclusion.map
        (SimplexCategory.δ (Fin.last (t + 2))))
  exact simplexPresheafIso_natural (SimplexCategory.δ (Fin.last (t + 2)))

/-- Degree-zero evaluation of the preserved outer-face pushout. -/
theorem outerFacePresheaf_pushout (t : ℕ) :
    IsPushout
      (DaggerSSet.toPresheaf.map (freeDagger.map
        (SSet.Subcomplex.homOfLE
          (inf_le_left : middleFace.{0} t ≤ firstOuterFace t))))
      (DaggerSSet.toPresheaf.map (freeDagger.map
        (SSet.Subcomplex.homOfLE
          (inf_le_right : middleFace.{0} t ≤ lastOuterFace t))))
      (DaggerSSet.toPresheaf.map (freeDagger.map
        (SSet.Subcomplex.homOfLE
          (le_sup_left : firstOuterFace.{0} t ≤ ordinaryOuterFaces t))))
      (DaggerSSet.toPresheaf.map (freeDagger.map
        (SSet.Subcomplex.homOfLE
          (le_sup_right : lastOuterFace.{0} t ≤ ordinaryOuterFaces t)))) := by
  let ev₀ : ReverseDaggerSpace.{0} ⥤ (ReverseSimplexᵒᵖ ⥤ Type) :=
    (Functor.whiskeringRight ReverseSimplexᵒᵖ SSet.{0} (Type)).obj
      ((evaluation SimplexCategoryᵒᵖ (Type)).obj (op ⦋0⦌))
  exact IsPushout.map ev₀
    (ReversalDiscreteFreeColimits.map_isPushout (outerFacePushout.{0} t))

/-- The image of the outer-face inclusion is exactly the literal Yoneda union. -/
theorem outerFacePresheafMap_range (t : ℕ) :
    Subfunctor.range (outerFacePresheafMap t) =
      outerFaceSubpresheafAt (t + 2) (by omega) := by
  let a := DaggerSSet.toPresheaf.map (freeDagger.map
    (SSet.Subcomplex.homOfLE
      (le_sup_left : firstOuterFace.{0} t ≤ ordinaryOuterFaces t)))
  let b := DaggerSSet.toPresheaf.map (freeDagger.map
    (SSet.Subcomplex.homOfLE
      (le_sup_right : lastOuterFace.{0} t ≤ ordinaryOuterFaces t)))
  let m := outerFacePresheafMap t
  let eFirst := (freeDagger ⋙ DaggerSSet.toPresheaf).mapIso
    (SSet.stdSimplex.faceSingletonComplIso.{0} (0 : Fin (t + 3)))
  let eLast := (freeDagger ⋙ DaggerSSet.toPresheaf).mapIso
    (SSet.stdSimplex.faceSingletonComplIso.{0} (Fin.last (t + 2)))
  have hfirst : eFirst.hom ≫ a ≫ m =
      (simplexPresheafIso (t + 1)).hom ≫
        yoneda.map (firstOuterCoface (t + 1)) := by
    change DaggerSSet.toPresheaf.map (freeDagger.map
        (SSet.stdSimplex.faceSingletonComplIso (0 : Fin (t + 3))).hom) ≫
      DaggerSSet.toPresheaf.map (freeDagger.map
        (SSet.Subcomplex.homOfLE
          (le_sup_left : firstOuterFace.{0} t ≤ ordinaryOuterFaces t))) ≫
      m = _
    rw [← Category.assoc, ← Functor.map_comp, ← Functor.map_comp]
    exact outerFacePresheafMap_first t
  have hlast : eLast.hom ≫ b ≫ m =
      (simplexPresheafIso (t + 1)).hom ≫
        yoneda.map (lastOuterCoface (t + 1)) := by
    change DaggerSSet.toPresheaf.map (freeDagger.map
        (SSet.stdSimplex.faceSingletonComplIso (Fin.last (t + 2))).hom) ≫
      DaggerSSet.toPresheaf.map (freeDagger.map
        (SSet.Subcomplex.homOfLE
          (le_sup_right : lastOuterFace.{0} t ≤ ordinaryOuterFaces t))) ≫
      m = _
    rw [← Category.assoc, ← Functor.map_comp, ← Functor.map_comp]
    exact outerFacePresheafMap_last t
  have hfirstRange : Subfunctor.range (a ≫ m) =
      Subfunctor.range (yoneda.map (firstOuterCoface (t + 1))) := by
    calc
      Subfunctor.range (a ≫ m) =
          Subfunctor.range (eFirst.hom ≫ (a ≫ m)) :=
        (range_precomp_iso eFirst (a ≫ m)).symm
      _ = Subfunctor.range ((simplexPresheafIso (t + 1)).hom ≫
            yoneda.map (firstOuterCoface (t + 1))) := by
        rw [hfirst]
      _ = _ := range_precomp_iso (simplexPresheafIso (t + 1)) _
  have hlastRange : Subfunctor.range (b ≫ m) =
      Subfunctor.range (yoneda.map (lastOuterCoface (t + 1))) := by
    calc
      Subfunctor.range (b ≫ m) =
          Subfunctor.range (eLast.hom ≫ (b ≫ m)) :=
        (range_precomp_iso eLast (b ≫ m)).symm
      _ = Subfunctor.range ((simplexPresheafIso (t + 1)).hom ≫
            yoneda.map (lastOuterCoface (t + 1))) := by
        rw [hlast]
      _ = _ := range_precomp_iso (simplexPresheafIso (t + 1)) _
  have hpush := range_pushout_eq_sup (outerFacePresheaf_pushout t) m
  change Subfunctor.range (a ≫ m) ⊔ Subfunctor.range (b ≫ m) =
    Subfunctor.range m at hpush
  rw [← hpush, hfirstRange, hlastRange]
  simp [outerFaceSubpresheafAt, outerFaceSubpresheaf]

/-- The underlying outer-face map is monic. -/
theorem outerFacePresheafMap_mono (t : ℕ) :
    Mono (outerFacePresheafMap t) := by
  have h : Mono (C2InvolutionActions.discreteDiagram.map
      (outerFacePresheafMap t)) := by
    rw [← daggerOuterFaceMap_yoneda]
    letI : Mono (daggerOuterFaceMap.{0} t) := daggerOuterFaceMap_mono t
    infer_instance
  apply (NatTrans.mono_iff_mono_app _).mpr
  intro c
  have hc := (NatTrans.mono_iff_mono_app _).mp h c
  have hq := (NatTrans.mono_iff_mono_app _).mp hc (op ⦋0⦌)
  exact hq

/-- Factor the outer-face map through the literal Yoneda subfunctor. -/
def outerFacePresheafLift (t : ℕ) :
    outerFacePresheaf t ⟶
      (outerFaceSubpresheafAt (t + 2) (by omega)).toFunctor :=
  Subfunctor.lift (outerFacePresheafMap t) (by
    rw [← outerFacePresheafMap_range t])

/-- The factorization is an isomorphism: the outer-face map is monic and
its image is exactly the union of the two Yoneda outer-face images. -/
theorem outerFacePresheafLift_isIso (t : ℕ) :
    IsIso (outerFacePresheafLift t) := by
  apply (NatTrans.isIso_iff_isIso_app _).mpr
  intro c
  apply (isIso_iff_bijective _).mpr
  constructor
  · intro x y h
    have hm := (NatTrans.mono_iff_mono_app _).mp
      (outerFacePresheafMap_mono t) c
    apply (CategoryTheory.mono_iff_injective _).mp hm
    exact congrArg Subtype.val h
  · intro z
    have hz : z.val ∈ (Subfunctor.range (outerFacePresheafMap t)).obj c := by
      rw [outerFacePresheafMap_range]
      exact z.property
    obtain ⟨x, hx⟩ := hz
    exact ⟨x, Subtype.ext hx⟩

/-- The underlying presheaf of the dagger outer-face union is the literal
subfunctor of the Yoneda representable. -/
def outerFacePresheafIso (t : ℕ) :
    outerFacePresheaf t ≅
      (outerFaceSubpresheafAt (t + 2) (by omega)).toFunctor := by
  letI : IsIso (outerFacePresheafLift t) := outerFacePresheafLift_isIso t
  exact asIso (outerFacePresheafLift t)

theorem outerFacePresheafIso_ι (t : ℕ) :
    (outerFacePresheafIso t).hom ≫
      (outerFaceSubpresheafAt (t + 2) (by omega)).ι =
      outerFacePresheafMap t := by
  change outerFacePresheafLift t ≫
    (outerFaceSubpresheafAt (t + 2) (by omega)).ι = _
  exact Subfunctor.lift_ι _ _

/-- The actual discrete free dagger outer-face object is the literal Yoneda union. -/
def daggerOuterFacesYonedaIso (t : ℕ) :
    daggerOuterFaces.{0} t ≅
      C2InvolutionActions.discreteDiagram.obj
        (outerFaceSubpresheafAt (t + 2) (by omega)).toFunctor :=
  C2InvolutionActions.discreteDiagram.mapIso (outerFacePresheafIso t)

/-- The Yoneda identifications preserve the specified outer-face inclusion. -/
theorem daggerOuterFacesYonedaIso_natural (t : ℕ) :
    daggerOuterFaceMap.{0} t ≫ (daggerSimplexYonedaIso (t + 2)).hom =
    (daggerOuterFacesYonedaIso t).hom ≫
      C2InvolutionActions.discreteDiagram.map
        (outerFaceSubpresheafAt (t + 2) (by omega)).ι := by
  rw [daggerOuterFaceMap_yoneda]
  change C2InvolutionActions.discreteDiagram.map (outerFacePresheafMap t) =
    C2InvolutionActions.discreteDiagram.map
      ((outerFacePresheafIso t).hom ≫
        (outerFaceSubpresheafAt (t + 2) (by omega)).ι)
  rw [outerFacePresheafIso_ι]

end

end DaggerModels.PartII.OuterFaceYonedaComparison
