import DaggerModelsPartII.JTRealizationGraphGenerator

/-!
# Equality of raw JT graphs is generated by vertical simplex operators

In a fixed horizontal degree, first absorb the horizontal coordinate of
each evaluated box into its coefficient. This carries every original
two-index colimit relation to a vertical relation between row graphs.
-/

set_option autoImplicit false

open CategoryTheory Limits Opposite Simplicial MonoidalCategory
open CartesianMonoidalCategory

namespace DaggerModels.PartII.JTRowGraphRelations

open OrdinaryJTRealization JTRealizationGenerators

noncomputable section

private abbrev Δ (d : SimplexCategory) := SSet.stdSimplex.{0}.obj d
private abbrev J := GroupoidSimplex.parameter

/-- A representative with literal horizontal identity in the fixed degree. -/
structure Graph (W : BiPresheaf) (d : SimplexCategory) where
  degree : SimplexCategory
  coefficient : W.obj (op (d, degree))
  parameter : Δ d ⟶ J.obj degree

variable {W : BiPresheaf} {d : SimplexCategory}

/-- The entire raw simplex represented by the graph. -/
def Graph.value (G : Graph W d) : Δ d ⟶ realization.obj W :=
  lift (𝟙 (Δ d)) G.parameter ≫ generator W (d, G.degree) G.coefficient

/-- An elementary coend step with the horizontal operator fixed to the identity. -/
inductive Step (W : BiPresheaf) (d : SimplexCategory) : Graph W d → Graph W d → Prop where
  | along : ∀ {k l : SimplexCategory} (j : k ⟶ l) (w : W.obj (op (d, l)))
      (s : Δ d ⟶ J.obj k),
      Step W d ⟨k, W.map (show (d, k) ⟶ (d, l) from (𝟙 d, j)).op w, s⟩
        ⟨l, w, s ≫ J.map j⟩

theorem Step.value_eq {A B : Graph W d} (h : Step W d A B) : A.value = B.value := by
  cases h with
  | @along k l j w s =>
    let f : (d, k) ⟶ (d, l) := (𝟙 d, j)
    have ht : lift (𝟙 (Δ d)) s ≫ tFunctor.map f =
        lift (𝟙 (Δ d)) (s ≫ J.map j) := by
      rw [tFunctor_map]
      change lift (𝟙 (Δ d)) s ≫ (SSet.stdSimplex.map (𝟙 d) ⊗ₘ J.map j) = _
      rw [SSet.stdSimplex.{0}.map_id]
      apply CartesianMonoidalCategory.hom_ext
      · simp only [Category.assoc, tensorHom_fst, lift_fst, Category.comp_id]
      · simp only [Category.assoc, tensorHom_snd, lift_snd, lift_snd_assoc]
    change lift (𝟙 (Δ d)) s ≫ generator W _ (W.map f.op w) =
      lift (𝟙 (Δ d)) (s ≫ J.map j) ≫ generator W _ w
    rw [← generator_relation W f w, ← Category.assoc, ht]

private abbrev Eval (d : SimplexCategory) : SSet.{0} ⥤ Type :=
  (evaluation _ _).obj (op d)

private abbrev evalDiagram (W : BiPresheaf) (d : SimplexCategory) :=
  simplexDiagram W ⋙ Eval d

private abbrev evalCocone (W : BiPresheaf) (d : SimplexCategory) :=
  (Eval d).mapCocone (simplexCocone W)

private def evalIsColimit (W : BiPresheaf) (d : SimplexCategory) :
    IsColimit (evalCocone W d) :=
  isColimitOfPreserves (Eval d) (simplexCoconeIsColimit W)

private def horizontal {m : SimplexCategory} (g : Δ d ⟶ Δ m) : d ⟶ m :=
  SSet.stdSimplex.objEquiv (SSet.yonedaEquiv g)

private theorem horizontal_map {m : SimplexCategory} (g : Δ d ⟶ Δ m) :
    SSet.stdSimplex.map (horizontal g) = g := by
  apply SSet.yonedaEquiv.injective
  rw [SSet.stdSimplex.yonedaEquiv_map]
  exact Equiv.symm_apply_apply _ _

private theorem horizontal_stdMap {m : SimplexCategory} (a : d ⟶ m) :
    horizontal (SSet.stdSimplex.map a) = a := by
  rw [horizontal, SSet.stdSimplex.yonedaEquiv_map, Equiv.apply_symm_apply]

private theorem horizontal_comp {m n : SimplexCategory} (g : Δ d ⟶ Δ m) (a : m ⟶ n) :
    horizontal (g ≫ SSet.stdSimplex.map a) = horizontal g ≫ a := by
  rw [← horizontal_stdMap (horizontal g ≫ a), SSet.stdSimplex.{0}.map_comp, horizontal_map]

private def normalize (σ : SimplexIndex W) (v : (evalDiagram W d).obj σ) : Graph W d :=
  let u : Δ d ⟶ Δ σ.left.1 ⊗ J.obj σ.left.2 := SSet.yonedaEquiv.symm v
  let a := horizontal (u ≫ fst _ _)
  ⟨σ.left.2,
    W.map (show (d, σ.left.2) ⟶ σ.left from (a, 𝟙 σ.left.2)).op
      (uliftYonedaEquiv.{0} σ.hom),
    u ≫ snd _ _⟩

private theorem coefficient_map {σ τ : SimplexIndex W} (f : σ ⟶ τ) :
    W.map f.left.op (uliftYonedaEquiv.{0} τ.hom) = uliftYonedaEquiv.{0} σ.hom := by
  apply (uliftYonedaEquiv.{0} (F := W)).symm.injective
  erw [uliftYonedaEquiv_symm_map f.left.op, Equiv.symm_apply_apply, Equiv.symm_apply_apply]
  exact CostructuredArrow.w f

private theorem normalize_step {σ τ : SimplexIndex W} (f : σ ⟶ τ)
    (v : (evalDiagram W d).obj σ) :
    Step W d (normalize σ v) (normalize τ ((evalDiagram W d).map f v)) := by
  let u : Δ d ⟶ Δ σ.left.1 ⊗ J.obj σ.left.2 := SSet.yonedaEquiv.symm v
  let a := horizontal (u ≫ fst _ _)
  let s := u ≫ snd (Δ σ.left.1) (J.obj σ.left.2)
  let b : (d, σ.left.2) ⟶ σ.left := (a, 𝟙 _)
  let c : (d, τ.left.2) ⟶ τ.left := (a ≫ f.left.1, 𝟙 _)
  let j : (d, σ.left.2) ⟶ (d, τ.left.2) := (𝟙 d, f.left.2)
  have hu : SSet.yonedaEquiv.symm ((evalDiagram W d).map f v) =
      u ≫ tFunctor.map f.left := by
    apply SSet.yonedaEquiv.injective
    rw [Equiv.apply_symm_apply, SSet.yonedaEquiv_comp]
    change _ = (tFunctor.map f.left).app (op d) (SSet.yonedaEquiv u)
    have h : SSet.yonedaEquiv u = v := Equiv.apply_symm_apply _ _
    exact congrArg ((tFunctor.map f.left).app (op d)) h.symm
  have hfst : horizontal ((u ≫ tFunctor.map f.left) ≫
      fst (Δ τ.left.1) (J.obj τ.left.2)) = a ≫ f.left.1 := by
    rw [Category.assoc, tFunctor_map, tensorHom_fst, ← Category.assoc, horizontal_comp]
  have hsnd : (u ≫ tFunctor.map f.left) ≫ snd (Δ τ.left.1) (J.obj τ.left.2) =
      s ≫ J.map f.left.2 := by
    rw [Category.assoc, tFunctor_map, tensorHom_snd, ← Category.assoc]
  have hcomp : b ≫ f.left = j ≫ c := by
    change (a ≫ f.left.1, 𝟙 _ ≫ f.left.2) =
      (𝟙 _ ≫ (a ≫ f.left.1), f.left.2 ≫ 𝟙 _)
    rw [Category.id_comp, Category.id_comp, Category.comp_id]
  have hw : W.map b.op (uliftYonedaEquiv.{0} σ.hom) =
      W.map j.op (W.map c.op (uliftYonedaEquiv.{0} τ.hom)) := by
    have h := congrArg (fun q : (d, σ.left.2) ⟶ τ.left ↦ W.map q.op
      (uliftYonedaEquiv.{0} τ.hom)) hcomp
    exact (congrArg (W.map b.op) (coefficient_map f).symm).trans
      (by simpa only [op_comp, Functor.map_comp, types_comp_apply] using h)
  unfold normalize
  dsimp only
  erw [hu, hfst, hsnd]
  change Step W d ⟨σ.left.2, W.map b.op (uliftYonedaEquiv.{0} σ.hom), s⟩
    ⟨τ.left.2, W.map c.op (uliftYonedaEquiv.{0} τ.hom), s ≫ J.map f.left.2⟩
  rw [hw]
  exact Step.along f.left.2 _ s

private def quotientCocone (W : BiPresheaf) (d : SimplexCategory) :
    Cocone (evalDiagram W d) where
  pt := Quot (Step W d)
  ι :=
    { app := fun σ v ↦ Quot.mk _ (normalize σ v)
      naturality := by
        intro σ τ f
        funext v
        exact (Quot.sound (normalize_step f v)).symm }

private theorem normalize_graph (G : Graph W d) :
    normalize (d := d) (CostructuredArrow.mk (uliftYonedaEquiv.{0}.symm G.coefficient))
      (SSet.yonedaEquiv (lift (𝟙 (Δ d)) G.parameter)) = G := by
  cases G with
  | mk k w s =>
    unfold normalize
    dsimp only
    erw [Equiv.symm_apply_apply, lift_fst, ← SSet.stdSimplex.{0}.map_id d,
      horizontal_stdMap, lift_snd]
    change Graph.mk k (W.map (𝟙 (op (d, k))) (uliftYonedaEquiv.{0}
      (uliftYonedaEquiv.{0}.symm w))) s = _
    rw [Equiv.apply_symm_apply, W.map_id]
    rfl

private theorem desc_graph (G : Graph W d) :
    (evalIsColimit W d).desc (quotientCocone W d) (SSet.yonedaEquiv G.value) =
      Quot.mk (Step W d) G := by
  let σ : SimplexIndex W := CostructuredArrow.mk (uliftYonedaEquiv.{0}.symm G.coefficient)
  let v := SSet.yonedaEquiv (lift (𝟙 (Δ d)) G.parameter)
  have h := congrFun ((evalIsColimit W d).fac (quotientCocone W d) σ) v
  change (evalIsColimit W d).desc (quotientCocone W d)
    ((generator W (d, G.degree) G.coefficient).app (op d) v) =
      Quot.mk _ (normalize σ v) at h
  rw [show (generator W (d, G.degree) G.coefficient).app (op d) v =
    SSet.yonedaEquiv G.value from (SSet.yonedaEquiv_comp _ _).symm,
    normalize_graph G] at h
  exact h

/-- Two entire raw graph maps agree precisely when the two row graphs are
linked by a zigzag of vertical coend steps in the same horizontal degree. -/
theorem value_eq_iff (A B : Graph W d) :
    A.value = B.value ↔ Relation.EqvGen (Step W d) A B := by
  constructor
  · intro h
    apply Quot.eq.mp
    rw [← desc_graph A, ← desc_graph B, h]
  · intro h
    induction h with
    | rel _ _ h => exact h.value_eq
    | refl _ => rfl
    | symm _ _ _ h => exact h.symm
    | trans _ _ _ _ _ h₁ h₂ => exact h₁.trans h₂

end

end DaggerModels.PartII.JTRowGraphRelations
