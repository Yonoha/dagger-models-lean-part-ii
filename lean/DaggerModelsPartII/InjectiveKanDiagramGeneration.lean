import DaggerModelsPartII.PresheafMonoGenerationLift

set_option autoImplicit false
open CategoryTheory Limits MorphismProperty
open scoped Simplicial
universe u
namespace DaggerModels.PartII.InjectiveKanDiagram
variable (C : Type u) [Category.{u} C]
noncomputable section

/-- The small quotient-subobject family has precisely the right lifting class
of all diagram monomorphisms. -/
theorem quotientSubobjectGenerators_rlp_eq_cofibrations_rlp :
    (quotientSubobjectGenerators C).rlp = (cofibrations C).rlp := by
  ext X Y p
  constructor
  · intro hp A B i hi
    haveI : Mono i := hi
    letI : Functor.IsEquivalence (Functor.uncurry :
        (C ⥤ SSet.{u}) ⥤ (C × SimplexCategoryᵒᵖ ⥤ Type u)) :=
      (Functor.currying :
        (C ⥤ SSet.{u}) ≌ (C × SimplexCategoryᵒᵖ ⥤ Type u)).isEquivalence_functor
    haveI : Mono (Functor.uncurry.map i) := inferInstance
    have hcyclic : ∀ (S : Subfunctor (Functor.uncurry.obj B))
        (d : C × SimplexCategoryᵒᵖ)
        (x : (Functor.uncurry.obj B).obj d),
        HasLiftingProperty
          (Subfunctor.homOfLe
            (inf_le_right : S ⊓ PresheafMonoGeneration.cyclicSubfunctor
              (Functor.uncurry.obj B) x ≤
                PresheafMonoGeneration.cyclicSubfunctor
                  (Functor.uncurry.obj B) x))
          (Functor.uncurry.map p) := by
      intro S d x
      obtain ⟨c, m⟩ := d
      obtain ⟨m⟩ := m
      induction m using SimplexCategory.rec with | _ n =>
        exact quotientSubobjectGenerators_rlp_cyclicIntersection C p hp S c n x
    have htype : HasLiftingProperty (Functor.uncurry.map i) (Functor.uncurry.map p) :=
      PresheafMonoGeneration.PartialLift.mono_hasLiftingProperty_of_cyclic
        (Functor.uncurry.map i) (Functor.uncurry.map p) hcyclic
    let e : (C ⥤ SSet.{u}) ≌ (C × SimplexCategoryᵒᵖ ⥤ Type u) := Functor.currying
    have hcur : HasLiftingProperty
        (Functor.curry.map (Functor.uncurry.map i)) p :=
      (e.symm.toAdjunction.hasLiftingProperty_iff (Functor.uncurry.map i) p).mpr htype
    let ei : Arrow.mk i ≅ Arrow.mk (Functor.curry.map (Functor.uncurry.map i)) :=
      Arrow.isoMk (e.unitIso.app A) (e.unitIso.app B)
        (e.unitIso.hom.naturality i).symm
    exact (HasLiftingProperty.iff_of_arrow_iso_left ei p).mpr hcur
  · intro hp A B i hi
    exact hp i ((quotientSubobjectGenerators_le_cofibrations C) i hi)


/-- The weak factorization system generated by quotient-subobject inclusions
has exactly all diagram monomorphisms as its left class. -/
theorem quotientGeneratedCofibrations_eq_cofibrations :
    (quotientSubobjectGenerators C).rlp.llp = cofibrations C := by
  apply le_antisymm
  · exact quotientGeneratedCofibrations_le_cofibrations C
  · intro A B i hi X Y p hp
    have hp' : (cofibrations C).rlp p := by
      rwa [← quotientSubobjectGenerators_rlp_eq_cofibrations_rlp C]
    exact hp' i hi

end
end DaggerModels.PartII.InjectiveKanDiagram
