import OrdinaryWalkingAlternatingExhaustion
import Mathlib.AlgebraicTopology.SimplicialSet.Degenerate

/-!
# The two new nondegenerate cells in an alternating stage

The top alternating binary word and its zero face are nondegenerate. The top
word cannot belong to the preceding generated stage by dimension, while the
zero face cannot belong there because its initial vertex differs. These are
statements about the codiscrete comparison of the same literal walking
parameter; they do not assume a cell-attachment pushout.
-/

set_option autoImplicit false
set_option warningAsError true

open CategoryTheory Opposite Simplicial

namespace DaggerModels.PartII.OrdinaryWalkingAlternatingNondegenerate

open OrdinaryWalkingAlternatingFiltration

noncomputable section

private abbrev BinaryNerve :=
  DaggerOriginalCodiscreteNerveInjective.codiscreteNerve.obj (Fin 2)

private theorem nonDegenerate_of_adjacent_ne (n : ℕ)
    (x : BinaryNerve.obj (op ⦋n⦌))
    (hx : ∀ i : Fin n, x.obj i.castSucc ≠ x.obj i.succ) :
    x ∈ BinaryNerve.nonDegenerate n := by
  cases n with
  | zero => simp
  | succ n =>
      rw [SSet.mem_nonDegenerate_iff_notMem_degenerate,
        BinaryNerve.degenerate_eq_iUnion_range_σ]
      intro h
      simp only [Set.mem_iUnion, Set.mem_range] at h
      obtain ⟨i, y, hy⟩ := h
      apply hx i
      rw [← hy]
      change ((nerve (Codiscrete (Fin 2))).σ i y).obj i.castSucc =
        ((nerve (Codiscrete (Fin 2))).σ i y).obj i.succ
      simp [nerve.σ_obj]

/-- The chosen top alternating word is nondegenerate in every degree. -/
theorem binaryWord_nonDegenerate (n : ℕ) :
    binaryWord n ∈ BinaryNerve.nonDegenerate n := by
  apply nonDegenerate_of_adjacent_ne
  intro i h
  have hval := congrArg (fun z : Codiscrete (Fin 2) ↦ z.as.val) h
  change i.val % 2 = (i.val + 1) % 2 at hval
  omega

/-- The zero face, which starts at vertex one, is also nondegenerate. -/
theorem binaryWord_zeroFace_nonDegenerate (k : ℕ) :
    BinaryNerve.map (SimplexCategory.δ (0 : Fin (k + 3))).op
        (binaryWord (k + 2)) ∈ BinaryNerve.nonDegenerate (k + 1) := by
  apply nonDegenerate_of_adjacent_ne
  intro i h
  have hval := congrArg (fun z : Codiscrete (Fin 2) ↦ z.as.val) h
  change ((0 : Fin (k + 3)).succAbove i.castSucc).val % 2 =
    ((0 : Fin (k + 3)).succAbove i.succ).val % 2 at hval
  rw [Fin.succAbove_zero_apply, Fin.succAbove_zero_apply] at hval
  change (i.val + 1) % 2 = (i.val + 2) % 2 at hval
  omega

/-- The top word cannot be generated by the preceding word: its source
simplex has one more vertex and is nondegenerate. -/
theorem binaryWord_top_not_previous (k : ℕ) :
    binaryWord (k + 2) ∉
      (SSet.Subcomplex.ofSimplex (binaryWord (k + 1))).obj (op ⦋k + 2⦌) := by
  intro h
  obtain ⟨f, hf⟩ :=
    (SSet.Subcomplex.mem_ofSimplex_obj_iff
      (binaryWord (k + 1)) (binaryWord (k + 2))).mp h
  haveI : Mono f := BinaryNerve.mono_of_nonDegenerate
    ⟨binaryWord (k + 2), binaryWord_nonDegenerate (k + 2)⟩
    f (binaryWord (k + 1)) hf
  have hdim := SimplexCategory.len_le_of_mono f
  simp only [SimplexCategory.len_mk] at hdim
  omega

/-- The missing zero face is a different nondegenerate word of the same
dimension as the preceding generator. -/
theorem binaryWord_zeroFace_not_previous (k : ℕ) :
    BinaryNerve.map (SimplexCategory.δ (0 : Fin (k + 3))).op
        (binaryWord (k + 2)) ∉
      (SSet.Subcomplex.ofSimplex (binaryWord (k + 1))).obj (op ⦋k + 1⦌) := by
  intro h
  obtain ⟨f, hf⟩ :=
    (SSet.Subcomplex.mem_ofSimplex_obj_iff
      (binaryWord (k + 1))
      (BinaryNerve.map (SimplexCategory.δ (0 : Fin (k + 3))).op
        (binaryWord (k + 2)))).mp h
  haveI : Mono f := BinaryNerve.mono_of_nonDegenerate
    ⟨_, binaryWord_zeroFace_nonDegenerate k⟩ f (binaryWord (k + 1)) hf
  haveI : IsIso f := (SimplexCategory.isIso_iff_of_mono f).2 (by simp)
  have hfid : f = 𝟙 _ := SimplexCategory.eq_id_of_isIso f
  rw [hfid, op_id, FunctorToTypes.map_id_apply] at hf
  have hfirst := congrArg
    (fun z : BinaryNerve.obj (op ⦋k + 1⦌) ↦ (z.obj 0).as.val) hf
  change (0 : ℕ) = 1 at hfirst
  omega

#print axioms binaryWord_nonDegenerate
#print axioms binaryWord_zeroFace_nonDegenerate
#print axioms binaryWord_top_not_previous
#print axioms binaryWord_zeroFace_not_previous

end

end DaggerModels.PartII.OrdinaryWalkingAlternatingNondegenerate
