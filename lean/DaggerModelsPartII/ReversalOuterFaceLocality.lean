import DaggerModelsPartII.ReversalOuterFaceSubobject
import DaggerModelsPartII.SegalLocalizers
import NativeStandardSpineGeometry

/-!
# The ordinary two outer faces and the reversal Segal map

The ordinary spine factors through the union of the first and final faces.
After applying the free dagger presheaf and the discrete embedding, this is
the exact factorization of the chosen reversal Segal map.
-/

set_option autoImplicit false

open CategoryTheory Opposite Simplicial

universe u

namespace DaggerModels.PartII.ReversalOuterFaceLocality

open SegalLocalizers DaggerNativeStandardSpineInner

noncomputable section

/-- The union of the two outer faces in a standard simplex of dimension at least two. -/
def ordinaryOuterFaces (t : ℕ) : (Δ[t + 2] : SSet.{u}).Subcomplex :=
  SSet.stdSimplex.face {(0 : Fin (t + 3))}ᶜ ⊔
    SSet.stdSimplex.face {(Fin.last (t + 2))}ᶜ

/-- A spine simplex cannot meet both extreme vertices in dimension at least two. -/
theorem spine_le_ordinaryOuterFaces (t : ℕ) :
    DaggerNativeStandardSpineInner.spine.{u} (t + 2) ≤ ordinaryOuterFaces t := by
  intro q c hc
  induction q using Opposite.rec with | op q =>
    induction q using SimplexCategory.rec with | h d =>
      have hs := (mem_spine_iff c).mp hc
      let l := SSet.stdSimplex.asOrderHom c 0
      let r := SSet.stdSimplex.asOrderHom c (Fin.last d)
      have hb (j : Fin (d + 1)) :
          l ≤ SSet.stdSimplex.asOrderHom c j ∧
            SSet.stdSimplex.asOrderHom c j ≤ r :=
        ⟨(SSet.stdSimplex.asOrderHom c).monotone (Fin.zero_le j),
          (SSet.stdSimplex.asOrderHom c).monotone (Fin.le_last j)⟩
      by_cases hr : r.val < t + 2
      · apply Or.inr
        rw [SSet.stdSimplex.mem_face_iff]
        intro j
        simp only [Finset.mem_compl, Finset.mem_singleton]
        intro he
        have hval := congrArg Fin.val he
        have hj := (hb j).2
        change (SSet.stdSimplex.asOrderHom c j).val ≤ r.val at hj
        change (SSet.stdSimplex.asOrderHom c j).val = t + 2 at hval
        omega
      · apply Or.inl
        rw [SSet.stdSimplex.mem_face_iff]
        intro j
        simp only [Finset.mem_compl, Finset.mem_singleton]
        intro he
        have hval := congrArg Fin.val he
        have hj := (hb j).1
        change l.val ≤ (SSet.stdSimplex.asOrderHom c j).val at hj
        change (SSet.stdSimplex.asOrderHom c j).val = 0 at hval
        have hsmall : r.val ≤ l.val + 1 := hs
        have hrle : r.val < t + 3 := r.isLt
        omega

/-- The ordinary spine inclusion factors through the two outer faces. -/
def spineToOuterFaces (t : ℕ) :
    ordinarySpine.{u} (t + 2) ⟶ (ordinaryOuterFaces t : SSet.{u}) :=
  SSet.Subcomplex.homOfLE (spine_le_ordinaryOuterFaces t)

@[reassoc (attr := simp)] theorem spineToOuterFaces_ι (t : ℕ) :
    spineToOuterFaces.{u} t ≫ (ordinaryOuterFaces t).ι =
      (DaggerNativeStandardSpineInner.spine (t + 2)).ι :=
  SSet.Subcomplex.homOfLE_ι (spine_le_ordinaryOuterFaces t)

/-- The discrete free dagger object generated by the two outer faces. -/
def daggerOuterFaces (t : ℕ) : ReverseDaggerSpace.{u} :=
  discreteDagger.obj (freeDagger.obj (ordinaryOuterFaces t : SSet.{u}))

/-- Its canonical inclusion in the reversal dagger simplex. -/
def daggerOuterFaceMap (t : ℕ) :
    daggerOuterFaces.{u} t ⟶ daggerSimplex.{u} (t + 2) :=
  discreteDagger.map (freeDagger.map (ordinaryOuterFaces t).ι)

theorem daggerOuterFaceMap_mono (t : ℕ) : Mono (daggerOuterFaceMap.{u} t) := by
  have h := freeDagger_map_isFreeCofibration (ordinaryOuterFaces.{u} t).ι
  letI : Mono (freeDagger.map (ordinaryOuterFaces.{u} t).ι) := h.1
  exact discreteDagger_map_mono _

/-- The selected Segal map factors through the outer-face union. -/
def daggerSpineToOuterFaces (t : ℕ) :
    daggerSpine.{u} (t + 2) ⟶ daggerOuterFaces.{u} t :=
  discreteDagger.map (freeDagger.map (spineToOuterFaces t))

@[reassoc (attr := simp)] theorem daggerSpineToOuterFaces_comp (t : ℕ) :
    daggerSpineToOuterFaces.{u} t ≫ daggerOuterFaceMap.{u} t =
      segalMap.{u} (t + 2) := by
  simp only [daggerSpineToOuterFaces, daggerOuterFaceMap, segalMap,
    ← Functor.map_comp, spineToOuterFaces_ι]

end

end DaggerModels.PartII.ReversalOuterFaceLocality
