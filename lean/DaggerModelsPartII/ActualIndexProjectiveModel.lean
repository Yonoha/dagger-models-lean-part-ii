import DaggerModelsPartII.DaggerSimplexPartIIndex
import DaggerModelsPartII.DaggerChangeOfIndex
import DaggerModelsPartII.FunctorialSegalLocalizers
import DaggerModelsPartII.KanLeftProper

/-!
# Projective Kan model on the exact Part I free dagger-simplex index

The index objects are the Part I free enriched dagger simplices, and its morphisms
are all enriched dagger functors. Its Hom sets are small, so the generic
projective Kan model applies directly.
-/

set_option autoImplicit false

open CategoryTheory MorphismProperty HomotopicalAlgebra Opposite
open DaggerModels.PartII.DaggerSimplexPartIIndex
open DaggerModels.PartII.SegalLocalizers
open DaggerModelsPartII.DaggerSimplexIndex
open scoped SSet.modelCategoryQuillen

namespace DaggerModels.PartII.ActualIndexProjectiveModel

universe v

abbrev PathSpace := DaggerSimplexᵒᵖ ⥤ SSet.{0}
abbrev ActualSpace := ActualDaggerSimplexᵒᵖ ⥤ SSet.{0}

noncomputable section

/-- The direct projective Kan model on actual Part I free dagger simplices. -/
def modelCategory : ModelCategory ActualSpace :=
  ProjectiveKanDiagram.modelCategory ActualDaggerSimplexᵒᵖ

local instance actualProjectiveModel : ModelCategory ActualSpace := modelCategory

local instance reversalProjectiveModel : ModelCategory ReverseDaggerSpace.{0} :=
  ProjectiveKanDiagram.modelCategory ReverseSimplexᵒᵖ

/-- Its weak equivalences are exactly the levelwise weak homotopy equivalences. -/
theorem weakEquivalences_eq :
    HomotopicalAlgebra.weakEquivalences ActualSpace =
      (HomotopicalAlgebra.weakEquivalences SSet.{0}).functorCategory
        ActualDaggerSimplexᵒᵖ :=
  ProjectiveKanDiagram.model_weakEquivalences ActualDaggerSimplexᵒᵖ

/-- Its fibrations are exactly the levelwise Kan fibrations. -/
theorem fibrations_eq :
    HomotopicalAlgebra.fibrations ActualSpace =
      (HomotopicalAlgebra.fibrations SSet.{0}).functorCategory
        ActualDaggerSimplexᵒᵖ :=
  ProjectiveKanDiagram.model_fibrations ActualDaggerSimplexᵒᵖ

/-- Its cofibrations are generated by the free boundary inclusions. -/
theorem cofibrations_eq :
    HomotopicalAlgebra.cofibrations ActualSpace =
      (ProjectiveKanDiagram.boundaryGenerators ActualDaggerSimplexᵒᵖ).rlp.llp :=
  ProjectiveKanDiagram.model_cofibrations ActualDaggerSimplexᵒᵖ

/-- Fibrancy in the actual projective model is pointwise Kan fibrancy. -/
theorem isFibrant_iff (W : ActualSpace) :
    IsFibrant W ↔ ∀ d, IsFibrant (W.obj d) :=
  ProjectiveKanDiagram.model_isFibrant_iff ActualDaggerSimplexᵒᵖ W

/-- The actual projective Kan model is left proper. -/
theorem leftProper {A B D P : ActualSpace} {i : A ⟶ B} {k : A ⟶ D}
    {l : B ⟶ P} {r : D ⟶ P} (sq : IsPushout i k l r)
    (hi : HomotopicalAlgebra.cofibrations ActualSpace i)
    (hk : HomotopicalAlgebra.weakEquivalences ActualSpace k) :
    HomotopicalAlgebra.weakEquivalences ActualSpace l :=
  ProjectiveKanDiagram.model_leftProper ActualDaggerSimplexᵒᵖ sq hi hk

/-- The path-to-actual index functor is surjective on objects. -/
theorem pathToActual_surjective : Function.Surjective pathToActual.obj := by
  intro ⟨n⟩
  exact ⟨⟨n⟩, rfl⟩

/-- Equivalence between actual Part I diagrams and path-index diagrams. -/
def diagramEquivalence : ActualSpace ≌ PathSpace :=
  (pathEquivalence.op.symm).congrLeft

/-- The chosen diagram equivalence restricts along the actual index functor. -/
theorem diagramEquivalence_functor_eq_restrict :
    diagramEquivalence.functor = restrictIndex pathToActual := rfl

/-- Restriction along the path equivalence detects each pointwise property. -/
theorem pathRestriction_levelwise_iff (P : MorphismProperty SSet.{0})
    {X Y : ActualSpace} (f : X ⟶ Y) :
    P.functorCategory DaggerSimplexᵒᵖ ((restrictIndex pathToActual).map f) ↔
      P.functorCategory ActualDaggerSimplexᵒᵖ f :=
  restrictIndex_levelwise_iff pathToActual pathToActual_surjective P f

/-- Restriction along the manuscript index functor. -/
abbrev actualRestriction :
    (ActualDaggerSimplexᵒᵖ ⥤ SSet.{v}) ⥤ ReverseDaggerSpace.{v} :=
  restrictIndex.{0, v} actualU

/-- Left Kan extension along the manuscript index functor. -/
abbrev actualLeftExtension :
    ReverseDaggerSpace.{v} ⥤ (ActualDaggerSimplexᵒᵖ ⥤ SSet.{v}) :=
  extendIndexLeft.{0, v} actualU

/-- Right Kan extension along the manuscript index functor. -/
abbrev actualRightExtension :
    ReverseDaggerSpace.{v} ⥤ (ActualDaggerSimplexᵒᵖ ⥤ SSet.{v}) :=
  extendIndexRight.{0, v} actualU

/-- The left Kan extension and restriction adjunction on actual Part I diagrams. -/
def actualLeftAdjunction : actualLeftExtension.{v} ⊣ actualRestriction.{v} :=
  extendIndexLeftAdjunction.{0, v} actualU

/-- The restriction and right Kan extension adjunction on actual Part I diagrams. -/
def actualRightAdjunction : actualRestriction.{v} ⊣ actualRightExtension.{v} :=
  extendIndexRightAdjunction.{0, v} actualU

/-- Left extension carries reversal representables to actual Part I representables. -/
def actualLeftExtension_simplicialYoneda :
    simplicialYoneda.{0, v} ReverseSimplex ⋙ actualLeftExtension.{v} ≅
      actualU ⋙ simplicialYoneda.{0, v} ActualDaggerSimplex :=
  extendIndexLeft_simplicialYoneda.{0, v} actualU

/-- At a representable, the unit includes reversal operators among enriched dagger functors. -/
theorem actualUnit_representable_mono (n : ReverseSimplex) :
    Mono (actualLeftAdjunction.{v}.unit.app
      ((simplicialYoneda.{0, v} ReverseSimplex).obj n)) :=
  extendIndexLeft_unit_simplicialYoneda_mono.{0, v} actualU n

/-- Restriction along the exact Part I index functor detects pointwise properties. -/
theorem actualRestriction_levelwise_iff (P : MorphismProperty SSet.{v})
    {X Y : ActualDaggerSimplexᵒᵖ ⥤ SSet.{v}} (f : X ⟶ Y) :
    P.functorCategory ReverseSimplexᵒᵖ (actualRestriction.{v}.map f) ↔
      P.functorCategory ActualDaggerSimplexᵒᵖ f :=
  restrictIndex_levelwise_iff.{0, v} actualU actualU_obj_bijective.2 P f

/-- The actual left Kan extension is left Quillen for the projective models. -/
theorem actualLeftAdjunction_projective_isQuillen :
    actualLeftAdjunction.{0}.IsQuillenAdjunction :=
  projectiveIndexAdjunction_isQuillen actualU

/-- Derived locality at the functorially chosen actual left Kan images is
equivalent to reversal Segal locality after restriction. -/
theorem actualProjectiveLocality_iff (W : ActualSpace) [IsFibrant W] :
    functorialImageSRev actualU ≤ homotopyMappingWeakEquivalences W ↔
      segalLocalizingFamily ≤
        homotopyMappingWeakEquivalences (actualRestriction.{0}.obj W) :=
  functorialImageSRev_iff actualU W

/-- Actual projective local objects have pointwise Kan fibrancy and
derived reversal Segal-local restriction. -/
theorem actualProjectiveLocalObjects_iff (W : ActualSpace) :
    (IsFibrant W ∧ functorialImageSRev actualU ≤ homotopyMappingWeakEquivalences W) ↔
      (∀ d, IsFibrant (W.obj d)) ∧
        segalLocalizingFamily ≤
          homotopyMappingWeakEquivalences (actualRestriction.{0}.obj W) := by
  constructor
  · rintro ⟨hW, h⟩
    letI := hW
    exact ⟨(isFibrant_iff W).mp hW, (actualProjectiveLocality_iff W).mp h⟩
  · rintro ⟨hW, h⟩
    letI := (isFibrant_iff W).mpr hW
    exact ⟨inferInstance, (actualProjectiveLocality_iff W).mpr h⟩

/-- Restriction reflects local equivalences between actual projective local objects. -/
theorem actualRestriction_reflectsLocalEquivalences {X Y : ActualSpace} (f : X ⟶ Y)
    (hX : Localization.localObject (functorialImageSRev actualU) X)
    (hY : Localization.localObject (functorialImageSRev actualU) Y)
    (hf : Localization.localEquivalences segalLocalizingFamily
      (actualRestriction.{0}.map f)) :
    Localization.localEquivalences (functorialImageSRev actualU) f := by
  letI := hX.1
  letI := hY.1
  have hRX : Localization.localObject segalLocalizingFamily (actualRestriction.{0}.obj X) :=
    ⟨projectiveRestriction_isFibrant actualU X,
      (actualProjectiveLocality_iff X).mp hX.2⟩
  have hRY : Localization.localObject segalLocalizingFamily (actualRestriction.{0}.obj Y) :=
    ⟨projectiveRestriction_isFibrant actualU Y,
      (actualProjectiveLocality_iff Y).mp hY.2⟩
  have hR := (Localization.localEquivalence_iff_weak_of_local
    segalLocalizingFamily (actualRestriction.{0}.map f) hRX hRY).mp hf
  have hw : HomotopicalAlgebra.weakEquivalences ActualSpace f :=
    (actualRestriction_levelwise_iff (HomotopicalAlgebra.weakEquivalences SSet.{0}) f).mp hR
  exact Localization.weakEquivalences_le_localEquivalences _ f hw

end

end DaggerModels.PartII.ActualIndexProjectiveModel
