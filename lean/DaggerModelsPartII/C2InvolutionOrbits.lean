import DaggerModelsPartII.ActionStrictOrbits
import DaggerModelsPartII.DiscreteBorelDiagram
import DaggerModelsPartII.BorelDiscreteOrbitsModel

/-!
# C₂ strict orbits and involution orbits

The categorical colimit of an actual C₂-action has the same explicit orbit
set as the quotient by its generator involution. The comparison is natural
in equivariant maps.
-/

set_option autoImplicit false

open CategoryTheory Limits Opposite Simplicial
open DaggerModels.FreeInvolution
open DaggerOriginalDaggerRealizationC2Action
open DaggerModels.PartII.ActionStrictOrbits

namespace DaggerModels.PartII.C2InvolutionOrbits

universe u

noncomputable section

/-- The actual two-element group has only the identity and its generator. -/
theorem c2_cases (g : C2.{u}) : g = 1 ∨ g = generator := by
  have hz : ∀ z : ZMod 2, z = 0 ∨ z = 1 := by decide
  rcases hz (Multiplicative.toAdd g.down) with h | h
  · left
    apply ULift.down_injective
    exact h
  · right
    apply ULift.down_injective
    exact h

/-- The generator as an involution on the underlying set of an action. -/
def generatorEquiv (A : Action (Type u) C2.{u}) : A.V ≃ A.V :=
  (A.ρAut generator).toEquiv

/-- The generator acts twice as the identity. -/
theorem generatorInvolutive (A : Action (Type u) C2.{u}) :
    Function.Involutive (generatorEquiv A) := by
  intro x
  have hg : generator.{u} * generator = (1 : C2.{u}) := by decide
  have hh : A.ρ generator ≫ A.ρ generator = 𝟙 A.V := by
    rw [← End.mul_def, ← map_mul, hg, Action.ρ_one]
  exact congrFun hh x

/-- The ordinary group-orbit relation is exactly the two-point relation
generated by the specified involution. -/
theorem actionOrbitRel_iff (A : Action (Type u) C2.{u}) (x y : A.V) :
    (let J := (Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj A
     letI : MulAction C2.{u} A.V :=
       (inferInstance : MulAction C2.{u} (J.obj (SingleObj.star C2.{u})))
     MulAction.orbitRel C2.{u} A.V x y) ↔
      x = y ∨ x = generatorEquiv A y := by
  simp only [MulAction.orbitRel_apply, MulAction.mem_orbit_iff]
  change (∃ g : C2.{u}, (A.ρ g) y = x) ↔ _
  constructor
  · rintro ⟨g, hg⟩
    rcases c2_cases g with rfl | rfl
    · exact Or.inl (by simpa using hg.symm)
    · exact Or.inr hg.symm
  · rintro (h | h)
    · exact ⟨1, by simpa using h.symm⟩
    · exact ⟨generator, h.symm⟩

/-- The group-orbit quotient is canonically the quotient by the generator
involution, without a freeness assumption. -/
def orbitQuotientEquiv (A : Action (Type u) C2.{u}) :
    (let J := (Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj A
     MulAction.orbitRel.Quotient C2.{u} (J.obj (SingleObj.star C2.{u}))) ≃
      Orbit (generatorEquiv A) (generatorInvolutive A) := by
  let J := (Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj A
  letI : MulAction C2.{u} A.V :=
    (inferInstance : MulAction C2.{u} (J.obj (SingleObj.star C2.{u})))
  exact {
    toFun := Quotient.lift (orbit (generatorEquiv A) (generatorInvolutive A))
      (by
        intro x y h
        exact Quotient.sound ((actionOrbitRel_iff A x y).mp h))
    invFun := Quotient.lift (fun x : A.V => Quotient.mk _ x)
      (by
        intro x y h
        exact Quotient.sound ((actionOrbitRel_iff A x y).mpr h))
    left_inv := by
      intro q
      induction q using Quotient.inductionOn with
      | _ x => rfl
    right_inv := by
      intro q
      induction q using Quotient.inductionOn with
      | _ x => rfl }

/-- The strict categorical orbit colimit is the explicit involution-orbit
set. -/
def strictOrbitEquiv (A : Action (Type u) C2.{u}) :
    (orbit (Type u) C2.{u}).obj A ≃
      Orbit (generatorEquiv A) (generatorInvolutive A) :=
  (SingleObj.Types.colimitEquivQuotient
    ((Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj A)).trans
    (orbitQuotientEquiv A)

theorem generatorEquiv_comm {A B : Action (Type u) C2.{u}}
    (f : A ⟶ B) (x : A.V) :
    f.hom (generatorEquiv A x) = generatorEquiv B (f.hom x) :=
  congrFun (f.comm generator) x

/-- The group-orbit quotient map is induced directly by an equivariant
function. -/
def orbitQuotientMap {A B : Action (Type u) C2.{u}} (f : A ⟶ B) :
    (let J := (Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj A
     MulAction.orbitRel.Quotient C2.{u} (J.obj (SingleObj.star C2.{u}))) →
    (let J := (Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj B
     MulAction.orbitRel.Quotient C2.{u} (J.obj (SingleObj.star C2.{u}))) := by
  let JA := (Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj A
  let JB := (Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj B
  letI : MulAction C2.{u} A.V :=
    (inferInstance : MulAction C2.{u} (JA.obj (SingleObj.star C2.{u})))
  letI : MulAction C2.{u} B.V :=
    (inferInstance : MulAction C2.{u} (JB.obj (SingleObj.star C2.{u})))
  exact Quotient.map' f.hom (by
    intro x y h
    apply (actionOrbitRel_iff B (f.hom x) (f.hom y)).mpr
    rcases (actionOrbitRel_iff A x y).mp h with h | h
    · exact Or.inl (congrArg f.hom h)
    · exact Or.inr ((congrArg f.hom h).trans (generatorEquiv_comm f y)))

/-- The quotient comparison commutes with every equivariant function. -/
theorem orbitQuotientEquiv_natural {A B : Action (Type u) C2.{u}}
    (f : A ⟶ B) (q) :
    orbitQuotientEquiv B (orbitQuotientMap f q) =
      DaggerModels.PartII.DiscreteBorelDiagram.strictOrbitMap
        (generatorEquiv A) (generatorInvolutive A)
        (generatorEquiv B) (generatorInvolutive B)
        f.hom (generatorEquiv_comm f) (orbitQuotientEquiv A q) := by
  induction q using Quotient.inductionOn with
  | _ x => rfl

theorem strictOrbitEquiv_ι (A : Action (Type u) C2.{u}) (x : A.V) :
    strictOrbitEquiv A
      (colimit.ι ((Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj A)
        (SingleObj.star C2.{u}) x) =
      orbit (generatorEquiv A) (generatorInvolutive A) x := by
  let J := (Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj A
  letI : MulAction C2.{u} A.V :=
    (inferInstance : MulAction C2.{u} (J.obj (SingleObj.star C2.{u})))
  have h : (SingleObj.Types.colimitEquivQuotient J)
      (colimit.ι J (SingleObj.star C2.{u}) x) =
      (Quotient.mk (MulAction.orbitRel C2.{u} A.V) x) := by
    rw [SingleObj.Types.colimitEquivQuotient_apply]
    rw [Types.colimitEquivColimitType_apply]
    rfl
  change orbitQuotientEquiv A
    ((SingleObj.Types.colimitEquivQuotient J)
      (colimit.ι J (SingleObj.star C2.{u}) x)) = _
  rw [h]
  rfl

/-- The canonical equivalence from categorical strict orbits to
involution orbits is natural for equivariant functions. -/
theorem strictOrbitEquiv_natural {A B : Action (Type u) C2.{u}}
    (f : A ⟶ B) (q : (orbit (Type u) C2.{u}).obj A) :
    strictOrbitEquiv B ((orbit (Type u) C2.{u}).map f q) =
      DaggerModels.PartII.DiscreteBorelDiagram.strictOrbitMap
        (generatorEquiv A) (generatorInvolutive A)
        (generatorEquiv B) (generatorInvolutive B)
        f.hom (generatorEquiv_comm f) (strictOrbitEquiv A q) := by
  let JA := (Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj A
  obtain ⟨j, x, hx⟩ := Types.jointly_surjective' (F := JA) q
  cases j
  rw [← hx]
  change strictOrbitEquiv B
    (colim.map ((Action.functorCategoryEquivalence (Type u) C2.{u}).functor.map f)
      (colimit.ι JA (SingleObj.star C2.{u}) x)) = _
  rw [Types.Colimit.ι_map_apply, strictOrbitEquiv_ι]
  dsimp only [JA]
  have hA : strictOrbitEquiv A
      (colimit.ι ((Action.functorCategoryEquivalence (Type u) C2.{u}).functor.obj A)
        PUnit.unit x) =
      orbit (generatorEquiv A) (generatorInvolutive A) x :=
    strictOrbitEquiv_ι A x
  rw [hA]
  rfl


end

end DaggerModels.PartII.C2InvolutionOrbits
