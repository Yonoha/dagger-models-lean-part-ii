import DaggerModelsPartII.GroupoidSimplex
import DaggerModelsPartII.JTCylinderCEComparison
import OriginalCodiscreteNerveInjective
import Mathlib.AlgebraicTopology.SimplicialSet.Subcomplex

/-!
# Alternating simplices in the literal ordinary walking groupoid parameter

The `k`th stage is generated by the alternating `k`-simplex starting at
vertex zero, transported through the checked isomorphism from the actual
groupoid-completed simplex to the codiscrete two-vertex nerve. The same
original walking parameter is retained. The attachment and exhaustion
properties of Rezk's filtration are separate geometric results.
-/

set_option autoImplicit false
set_option warningAsError true

open CategoryTheory Opposite Simplicial

namespace DaggerModels.PartII.OrdinaryWalkingAlternatingFiltration

noncomputable section

private abbrev Walking := GroupoidSimplex.parameter.obj ⦋1⦌
private abbrev BinaryNerve :=
  DaggerOriginalCodiscreteNerveInjective.codiscreteNerve.obj (Fin 2)

/-- The checked comparison has the actual walking parameter as its source. -/
def walkingCodiscreteIso : Walking ≅ BinaryNerve :=
  GroupoidSimplex.parameterCodiscreteIso.app ⦋1⦌

/-- The alternating word of length `k+1` in the codiscrete two-object nerve. -/
def binaryWord (k : ℕ) : BinaryNerve.obj (op ⦋k⦌) :=
  Codiscrete.functor (fun j : Fin (k + 1) ↦
    (⟨j.val % 2, Nat.mod_lt _ (by decide)⟩ : Fin 2))

/-- The same alternating word in the literal completed-simplex parameter. -/
def alternatingSimplex (k : ℕ) : Walking.obj (op ⦋k⦌) :=
  walkingCodiscreteIso.inv.app (op ⦋k⦌) (binaryWord k)

/-- Rezk's stage `E(k)` is generated by one specified alternating simplex. -/
def stage (k : ℕ) : Walking.Subcomplex :=
  SSet.Subcomplex.ofSimplex (alternatingSimplex k)

/-- Omitting the last vertex of the next alternating simplex gives the
current alternating simplex, before transporting to the actual parameter. -/
theorem binaryWord_lastFace (k : ℕ) :
    BinaryNerve.map (SimplexCategory.δ (Fin.last (k + 1))).op
        (binaryWord (k + 1)) = binaryWord k := by
  apply nerve.ext_of_isThin
  funext j
  change ((nerve (Codiscrete (Fin 2))).δ (Fin.last (k + 1))
      (binaryWord (k + 1))).obj j = (binaryWord k).obj j
  rw [nerve.δ_obj, Fin.succAbove_last_apply]
  rfl

/-- The literal parameter has the same last-face equation. -/
theorem alternatingSimplex_lastFace (k : ℕ) :
    Walking.map (SimplexCategory.δ (Fin.last (k + 1))).op
        (alternatingSimplex (k + 1)) = alternatingSimplex k := by
  have h := congrFun (walkingCodiscreteIso.inv.naturality
    (SimplexCategory.δ (Fin.last (k + 1))).op) (binaryWord (k + 1))
  change Walking.map (SimplexCategory.δ (Fin.last (k + 1))).op
      (alternatingSimplex (k + 1)) =
    walkingCodiscreteIso.inv.app (op ⦋k⦌)
      (BinaryNerve.map (SimplexCategory.δ (Fin.last (k + 1))).op
        (binaryWord (k + 1))) at h
  rw [binaryWord_lastFace] at h
  exact h

/-- Every stage embeds in the next one through its literal last face. -/
theorem stage_le_succ (k : ℕ) : stage k ≤ stage (k + 1) := by
  rw [stage, stage, SSet.Subcomplex.ofSimplex_le_iff,
    SSet.Subcomplex.mem_ofSimplex_obj_iff]
  exact ⟨SimplexCategory.δ (Fin.last (k + 1)), alternatingSimplex_lastFace k⟩

#print axioms walkingCodiscreteIso
#print axioms binaryWord_lastFace
#print axioms alternatingSimplex_lastFace
#print axioms stage_le_succ

end

end DaggerModels.PartII.OrdinaryWalkingAlternatingFiltration
