import DaggerModelsPartII.JTJointPairSubdivisionDiagram
import Mathlib.CategoryTheory.MorphismProperty.Basic

/-!
Actual subdivision arrows retain their original pair transport and refinement.
Every vertical refinement is generated by insertions of individual original
vertices. This is a reduction for constructing evaluation comparisons, not a
claim that the normalized evaluation comparisons have already been supplied.
-/

set_option autoImplicit false
set_option warningAsError true

open CategoryTheory Limits Opposite Simplicial DaggerModels
open DaggerChosenRigidificationNecklace DaggerChosenRigidificationNecklace.NecklaceCode

namespace DaggerModels.PartII.JTJointSubdivisionRefinements

open JTParametrizedTargetFamilies (Family codes)
open JTTargetJointMarks (Joint)
open JTProjectiveOrderedFiberComparison (row)
open JTJointPairSubdivisionDiagram (Subdivision Admissible Index diagram refinement)

noncomputable section

private abbrev Source := SegalLocalizers.ReverseDaggerSpace.{0}
private abbrev Raw (W : Source) :=
  OrdinaryJTRealization.realization.obj (JTReversalInput.ordinaryInput.obj W)
private abbrev Vertex (W : Source) := (row W ⦋0⦌).obj (op ⦋0⦌)
private abbrev rawVertex := JTProjectiveRealizationMappingWeak.rawZeroGeneratorVertex

variable {A : Type} [SmallCategory A] {W : Source} {x y : Vertex W}
variable {Q : NecklacesOver (Raw W) (rawVertex W x) (rawVertex W y)}
variable {L : A ⥤ DecoratedNecklaceHomDiagram.Index W x y}
variable {time : A ⥤ SimplexCategory} (F : Family Q L time) (j : Joint Q.code)

private abbrev E := JTJointPairSourceDiagram.Index F j
private abbrev T (p : E F j) := (codes L).obj p.1

/-- A subdivision arrow's remaining vertical part after its literal native image. -/
def vertical {X Y : Index F j} (f : X ⟶ Y) : X.transport f.base ⟶ Y :=
  ⟨𝟙 Y.base, eqToHom (by simp) ≫ f.fiber⟩

/-- The vertical part preserves the original exact pair and its two cuts. -/
theorem vertical_base {X Y : Index F j} (f : X ⟶ Y) :
    (vertical F j f).base = 𝟙 Y.base := rfl

/-- Every actual subdivision arrow factors as native transport then refinement. -/
theorem arrow_factor {X Y : Index F j} (f : X ⟶ Y) :
    Grothendieck.toTransport X f.base ≫ vertical F j f = f := by
  apply Grothendieck.ext
  · simp [vertical]
  · simp [vertical]

/-- The target subdivision contains the complete literal image cut set. -/
theorem image_le {X Y : Index F j} (f : X ⟶ Y) :
    JTJointPairSubdivisionDiagram.transport F j f.base X.fiber ≤ Y.fiber :=
  leOfHom f.fiber

/-- The remaining vertical arrow is exactly inclusion of the transported cut set. -/
theorem vertical_eq_refinement {X Y : Index F j} (f : X ⟶ Y) :
    vertical F j f = refinement F j Y.base
      (JTJointPairSubdivisionDiagram.transport F j f.base X.fiber) Y.fiber
      (image_le F j f) := by
  apply Grothendieck.ext
  case w_base => rfl
  case w_fiber => exact Subsingleton.elim (α :=
      (((diagram F j).map (𝟙 Y.base)).toFunctor.obj
        (JTJointPairSubdivisionDiagram.transport F j f.base X.fiber) :
        Subdivision F j Y.base) ⟶ (Y.fiber : Subdivision F j Y.base)) _ _

/-- Insert an original vertex lying between the actual two endpoint cuts. -/
def insertCut (p : E F j) (C : Subdivision F j p) (t : Fin ((T F j p).len + 1))
    (ht : p.2.left.val ≤ t ∧ t ≤ p.2.right.val) : Subdivision F j p :=
  ⟨insert t C.val, by
    refine ⟨Finset.mem_insert_of_mem C.property.1,
      Finset.mem_insert_of_mem C.property.2.1, ?_, ?_⟩
    · intro v hv
      rcases Finset.mem_insert.mp hv with rfl | hv
      · exact ht
      · exact C.property.2.2.1 v hv
    · intro v hv hl hr
      exact Finset.mem_insert_of_mem (C.property.2.2.2 v hv hl hr)⟩

/-- Inserting a vertex is a genuine refinement over the same original pair. -/
theorem le_insertCut (p : E F j) (C : Subdivision F j p)
    (t : Fin ((T F j p).len + 1)) (ht : p.2.left.val ≤ t ∧ t ≤ p.2.right.val) :
    C ≤ insertCut F j p C t ht := Finset.subset_insert _ _

/-- Reinserting a cut already present leaves its subdivision unchanged. -/
theorem insertCut_of_mem (p : E F j) (C : Subdivision F j p)
    (t : Fin ((T F j p).len + 1)) (ht : p.2.left.val ≤ t ∧ t ≤ p.2.right.val)
    (h : t ∈ C.val) : insertCut F j p C t ht = C :=
  Subtype.ext (Finset.insert_eq_of_mem h)

/-- The two orders of inserting cuts have literally the same final subdivision. -/
theorem insertCut_comm (p : E F j) (C : Subdivision F j p)
    (s t : Fin ((T F j p).len + 1))
    (hs : p.2.left.val ≤ s ∧ s ≤ p.2.right.val)
    (ht : p.2.left.val ≤ t ∧ t ≤ p.2.right.val) :
    insertCut F j p (insertCut F j p C s hs) t ht =
      insertCut F j p (insertCut F j p C t ht) s hs :=
  Subtype.ext (Finset.insert_comm _ _ _)

/-- Every original pair arrow preserves the bounds of a vertex to be inserted. -/
theorem image_bounds {p q : E F j} (f : p ⟶ q) (t : Fin ((T F j p).len + 1))
    (ht : p.2.left.val ≤ t ∧ t ≤ p.2.right.val) :
    q.2.left.val ≤ orderMap ((codes L).map f.val).map t ∧
      orderMap ((codes L).map f.val).map t ≤ q.2.right.val := by
  constructor
  · simpa only [JTJointPairSourceDiagram.left_map F j f] using
      (orderMap ((codes L).map f.val).map).monotone ht.1
  · simpa only [JTJointPairSourceDiagram.right_map F j f] using
      (orderMap ((codes L).map f.val).map).monotone ht.2

/-- Exact native transport commutes with one-cut insertion, even when images coalesce. -/
theorem transport_insertCut {p q : E F j} (f : p ⟶ q) (C : Subdivision F j p)
    (t : Fin ((T F j p).len + 1)) (ht : p.2.left.val ≤ t ∧ t ≤ p.2.right.val) :
    JTJointPairSubdivisionDiagram.transport F j f (insertCut F j p C t ht) =
      insertCut F j q (JTJointPairSubdivisionDiagram.transport F j f C)
        (orderMap ((codes L).map f.val).map t) (image_bounds F j f t ht) := by
  apply Subtype.ext
  change (insert t C.val).image (orderMap ((codes L).map f.val).map) =
    insert (orderMap ((codes L).map f.val).map t)
      (C.val.image (orderMap ((codes L).map f.val).map))
  exact Finset.image_insert _ _ _

/-- All composites of a fixed vertical refinement have the same actual arrow. -/
theorem refinement_comp (p : E F j) (C D H : Subdivision F j p)
    (hCD : C ≤ D) (hDH : D ≤ H) :
    refinement F j p C D hCD ≫ refinement F j p D H hDH =
      refinement F j p C H (hCD.trans hDH) := by
  exact ((Grothendieck.ι (diagram F j) p).map_comp
    (homOfLE hCD : C ⟶ D) (homOfLE hDH : D ⟶ H)).symm

private theorem admissible_between (p : E F j) (C D : Subdivision F j p)
    (S : Finset (Fin ((T F j p).len + 1))) (hCS : C.val ⊆ S) (hSD : S ⊆ D.val) :
    Admissible F j p S := by
  refine ⟨hCS C.property.1, hCS C.property.2.1, ?_, ?_⟩
  · intro v hv
    exact D.property.2.2.1 v (hSD hv)
  · intro v hv hl hr
    exact hCS (C.property.2.2.2 v hv hl hr)

private theorem property_of_endpoint_eq (p : E F j) (P : MorphismProperty (Index F j))
    (C D H : Subdivision F j p) (hCD : C ≤ D) (hCH : C ≤ H) (e : D = H)
    (h : P (refinement F j p C D hCD)) : P (refinement F j p C H hCH) := by
  subst H
  exact h

/-- To prove a property of all actual vertical refinement arrows, it suffices to
prove it for identities, composition and insertion of one original vertex.
No claim about the normalized evaluation of these arrows is assumed here. -/
theorem refinement_induction (p : E F j) (P : MorphismProperty (Index F j))
    (hid : ∀ C : Subdivision F j p, P (𝟙 (⟨p, C⟩ : Index F j)))
    (hcomp : ∀ {X Y Z : Index F j} (f : X ⟶ Y) (g : Y ⟶ Z),
      P f → P g → P (f ≫ g))
    (hins : ∀ (C : Subdivision F j p) (t : Fin ((T F j p).len + 1))
      (ht : p.2.left.val ≤ t ∧ t ≤ p.2.right.val),
      P (refinement F j p C (insertCut F j p C t ht) (le_insertCut F j p C t ht)))
    (C D : Subdivision F j p) (hCD : C ≤ D) : P (refinement F j p C D hCD) := by
  suffices ∀ (S : Finset (Fin ((T F j p).len + 1))) (hS : Admissible F j p S)
      (hCS : C.val ⊆ S), P (refinement F j p C ⟨S, hS⟩ hCS) from
    this D.val D.property hCD
  intro S
  refine Finset.strongInductionOn S ?_
  intro S ih hS hCS
  let D : Subdivision F j p := ⟨S, hS⟩
  by_cases he : S = C.val
  · subst S
    change P (refinement F j p C C le_rfl)
    have hr : refinement F j p C C le_rfl = 𝟙 (⟨p, C⟩ : Index F j) :=
      (Grothendieck.ι (diagram F j) p).map_id C
    rw [hr]
    exact hid C
  · have hn : ¬S ⊆ C.val := fun h ↦ he (Finset.Subset.antisymm h hCS)
    obtain ⟨t, htS, htC⟩ := Finset.not_subset.mp hn
    have hCE : C.val ⊆ S.erase t := by
      intro v hv
      exact Finset.mem_erase.mpr ⟨fun h ↦ htC (h ▸ hv), hCS hv⟩
    let H : Subdivision F j p :=
      ⟨S.erase t, admissible_between F j p C D _ hCE (Finset.erase_subset _ _)⟩
    have ht : p.2.left.val ≤ t ∧ t ≤ p.2.right.val := hS.2.2.1 t htS
    have hHI : insertCut F j p H t ht = D :=
      Subtype.ext (Finset.insert_erase htS)
    have hCH := ih (S.erase t) (Finset.erase_ssubset htS) H.property hCE
    have hi := hins H t ht
    have hi' : P (refinement F j p H D (hHI ▸ le_insertCut F j p H t ht)) := by
      exact property_of_endpoint_eq F j p P H _ D _ _ hHI hi
    change P (refinement F j p C D hCS)
    rw [← refinement_comp F j p C H D hCE (hHI ▸ le_insertCut F j p H t ht)]
    exact hcomp _ _ hCH hi'

/-- A property of all actual subdivision arrows follows from its compatibility
with native transport and one-cut insertions, identities and composition.
This does not supply the missing normalized evaluation compatibility itself. -/
theorem all_arrows (P : MorphismProperty (Index F j))
    (hid : ∀ X : Index F j, P (𝟙 X))
    (hcomp : ∀ {X Y Z : Index F j} (f : X ⟶ Y) (g : Y ⟶ Z),
      P f → P g → P (f ≫ g))
    (hnative : ∀ (X : Index F j) {p : E F j} (f : X.base ⟶ p),
      P (Grothendieck.toTransport X f))
    (hins : ∀ (p : E F j) (C : Subdivision F j p) (t : Fin ((T F j p).len + 1))
      (ht : p.2.left.val ≤ t ∧ t ≤ p.2.right.val),
      P (refinement F j p C (insertCut F j p C t ht) (le_insertCut F j p C t ht)))
    {X Y : Index F j} (f : X ⟶ Y) : P f := by
  have hv := refinement_induction F j Y.base P (fun C ↦ hid ⟨Y.base, C⟩)
    hcomp (hins Y.base) _ Y.fiber (image_le F j f)
  rw [← vertical_eq_refinement F j f] at hv
  rw [← arrow_factor F j f]
  exact hcomp _ _ (hnative X f.base) hv

end
end DaggerModels.PartII.JTJointSubdivisionRefinements
