import DaggerModelsPartII.DiagramRegularImages
import Mathlib.CategoryTheory.Limits.Types.Pushouts
import Mathlib.CategoryTheory.Subfunctor.Basic

set_option autoImplicit false
open CategoryTheory Limits
universe u v
namespace DaggerModels.PartII.PresheafMonoGeneration
variable {D : Type u} [Category.{u} D] {F : D ⥤ Type v}

/-- The union of two subfunctors is the pushout of their intersection. -/
theorem subfunctor_union_isPushout (S T : Subfunctor F) :
    IsPushout
      (Subfunctor.homOfLe (inf_le_left : S ⊓ T ≤ S))
      (Subfunctor.homOfLe (inf_le_right : S ⊓ T ≤ T))
      (Subfunctor.homOfLe (le_sup_left : S ≤ S ⊔ T))
      (Subfunctor.homOfLe (le_sup_right : T ≤ S ⊔ T)) := by
  let a := Subfunctor.homOfLe (inf_le_left : S ⊓ T ≤ S)
  let b := Subfunctor.homOfLe (inf_le_right : S ⊓ T ≤ T)
  let c := Subfunctor.homOfLe (le_sup_left : S ≤ S ⊔ T)
  let d := Subfunctor.homOfLe (le_sup_right : T ≤ S ⊔ T)
  have w : a ≫ c = b ≫ d := by ext U x; rfl
  change IsPushout a b c d
  apply IsPushout.of_isColimit (c := PushoutCocone.mk c d w)
  apply evaluationJointlyReflectsColimits
  intro U
  let aa := a.app U
  let bb := b.app U
  let cc := c.app U
  let dd := d.app U
  have hpb : IsPullback aa bb cc dd := by
    apply (Types.isPullback_iff (t := aa) (l := bb) (r := cc) (b := dd)).mpr
    refine ⟨by funext x; rfl, ?_, ?_⟩
    · intro x y h
      have hv : x.val = y.val := by
        simpa [aa, a, Subfunctor.homOfLe] using
          congrArg (fun z : S.toFunctor.obj U => z.val) h.1
      exact Subtype.ext hv
    · intro x y h
      have hv : x.val = y.val := by
        simpa [cc, dd, c, d, Subfunctor.homOfLe] using
          congrArg (fun z : (S ⊔ T).toFunctor.obj U => z.val) h
      refine ⟨⟨x.val, ⟨x.prop, hv ▸ y.prop⟩⟩, ?_, ?_⟩
      · exact Subtype.ext rfl
      · exact Subtype.ext hv
  have hsurj : Set.range cc ⊔ Set.range dd = Set.univ := by
    apply Set.eq_univ_iff_forall.mpr
    intro x
    rcases x.prop with hx | hx
    · exact Or.inl ⟨⟨x.val, hx⟩, Subtype.ext rfl⟩
    · exact Or.inr ⟨⟨x.val, hx⟩, Subtype.ext rfl⟩
  have hpush : IsPushout aa bb cc dd :=
    Types.isPushout_of_isPullback_of_mono' hpb hsurj (by
      intro x y _ _ h
      have hv : x.val = y.val := by
        simpa [dd, d, Subfunctor.homOfLe] using
          congrArg (fun z : (S ⊔ T).toFunctor.obj U => z.val) h
      exact Subtype.ext hv)
  exact (isColimitMapCoconePushoutCoconeEquiv
    ((evaluation D (Type v)).obj U) w).symm (by
      change IsColimit hpush.cocone
      exact hpush.isColimit)


/-- The subfunctor generated by one element of a covariant Type-valued functor. -/
def cyclicSubfunctor (F : D ⥤ Type v) {d : D} (x : F.obj d) : Subfunctor F where
  obj e := { y | ∃ f : d ⟶ e, F.map f x = y }
  map f := by
    rintro y ⟨g, rfl⟩
    exact ⟨g ≫ f, by simp⟩

/-- The chosen element belongs to its cyclic subfunctor. -/
theorem mem_cyclicSubfunctor (F : D ⥤ Type v) {d : D} (x : F.obj d) :
    x ∈ (cyclicSubfunctor F x).obj d := by
  exact ⟨𝟙 d, by simp⟩

/-- A subfunctor contains a cyclic subfunctor exactly when it contains its generator. -/
theorem cyclicSubfunctor_le_iff (F : D ⥤ Type v) {d : D} (x : F.obj d)
    (S : Subfunctor F) :
    cyclicSubfunctor F x ≤ S ↔ x ∈ S.obj d := by
  constructor
  · intro h
    exact h d (mem_cyclicSubfunctor F x)
  · intro hx e y hy
    obtain ⟨f, rfl⟩ := hy
    exact S.map f hx


/-- A lift on a subfunctor extends across one cyclic subfunctor when the
intersection inclusion has the right lifting property. -/
theorem extendLiftAcrossUnion {B X Y : D ⥤ Type v} (S T : Subfunctor B)
    (p : X ⟶ Y) (β : B ⟶ Y) (s : S.toFunctor ⟶ X)
    (hs : s ≫ p = S.ι ≫ β)
    (hl : HasLiftingProperty
      (Subfunctor.homOfLe (inf_le_right : S ⊓ T ≤ T)) p) :
    ∃ u : (S ⊔ T).toFunctor ⟶ X,
      Subfunctor.homOfLe (le_sup_left : S ≤ S ⊔ T) ≫ u = s ∧
      u ≫ p = (S ⊔ T).ι ≫ β := by
  let a := Subfunctor.homOfLe (inf_le_left : S ⊓ T ≤ S)
  let b := Subfunctor.homOfLe (inf_le_right : S ⊓ T ≤ T)
  let c := Subfunctor.homOfLe (le_sup_left : S ≤ S ⊔ T)
  let d := Subfunctor.homOfLe (le_sup_right : T ≤ S ⊔ T)
  letI : HasLiftingProperty b p := hl
  have w : (a ≫ s) ≫ p = b ≫ (T.ι ≫ β) := by
    calc
      (a ≫ s) ≫ p = a ≫ (s ≫ p) := by simp
      _ = a ≫ (S.ι ≫ β) := by rw [hs]
      _ = (a ≫ S.ι) ≫ β := by simp
      _ = (b ≫ T.ι) ≫ β := by simp [a, b]
      _ = b ≫ (T.ι ≫ β) := by simp
  let sq : CommSq (a ≫ s) b p (T.ι ≫ β) := ⟨w⟩
  let t : T.toFunctor ⟶ X := sq.lift
  have ht₁ : b ≫ t = a ≫ s := sq.fac_left
  have ht₂ : t ≫ p = T.ι ≫ β := sq.fac_right
  have hcompat : a ≫ s = b ≫ t := ht₁.symm
  let push := subfunctor_union_isPushout S T
  let u := push.desc s t hcompat
  refine ⟨u, push.inl_desc s t hcompat, ?_⟩
  apply push.hom_ext
  · calc
      c ≫ (u ≫ p) = s ≫ p := by rw [← Category.assoc, push.inl_desc]
      _ = S.ι ≫ β := hs
      _ = c ≫ ((S ⊔ T).ι ≫ β) := by simp [c]
  · calc
      d ≫ (u ≫ p) = t ≫ p := by rw [← Category.assoc, push.inr_desc]
      _ = T.ι ≫ β := ht₂
      _ = d ≫ ((S ⊔ T).ι ≫ β) := by simp [d]

end DaggerModels.PartII.PresheafMonoGeneration
